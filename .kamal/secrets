# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Rails master key for credentials decryption
RAILS_MASTER_KEY=$(cat config/master.key)

# Google Artifact Registry authentication (base64-encoded service account JSON key).
# In CI, this is set via the GCP_ARTIFACT_REGISTRY_KEY environment variable from GitHub Secrets.
# Locally, export GCP_ARTIFACT_REGISTRY_KEY before running kamal deploy.
GCP_ARTIFACT_REGISTRY_KEY=$GCP_ARTIFACT_REGISTRY_KEY

# Database connection URL (Cloud SQL PostgreSQL via private IP)
# Set via environment variable or fetch from Terraform output:
# DATABASE_URL=postgres://silken_net:<password>@<cloud-sql-private-ip>:5432/silken_net_production
DATABASE_URL=$DATABASE_URL

# Redis connection URL (Upstash — serverless Redis with TLS public endpoints).
# Replaces GCP Memorystore (which has no public IP for Akash connectivity).
# Sign up at https://upstash.com/ → Create Redis database → Copy connection URL.
# Format: rediss://default:password@endpoint.upstash.io:6379
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379/0
REDIS_URL=$REDIS_URL

# Redis URL for Kredis distributed locks (Web3 nonce management).
# Same Upstash instance, DB 1 to isolate locks from Sidekiq queue data.
# KREDIS_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379/1
KREDIS_REDIS_URL=$KREDIS_REDIS_URL

# Sentry DSN for error tracking in production.
# Without this, Sentry is inert and no errors are reported.
# Set via environment variable from your Sentry project settings.
SENTRY_DSN=$SENTRY_DSN

# HKDF master key for hardware provisioning (AES key derivation).
# Without this, provisioning endpoint returns raw AES key in response (TRL4 lab mode only).
# MUST be set in production to enable per-device HKDF key derivation.
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
PROVISIONING_MASTER_KEY=$PROVISIONING_MASTER_KEY
