# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# Named `secrets-common` ON PURPOSE (INF.22): with a destination (`kamal deploy -d canopy`)
# Kamal reads ONLY `secrets-common` + `secrets.<destination>` — a plain `secrets` file is
# INVISIBLE to destination runs (verified against kamal 2.12 Kamal::Secrets), so the canopy
# leg would raise "Secret not found" on its first global env.secret lookup. `-common` feeds
# both legs (the plain production deploy reads it too).

# Rails master key for credentials decryption.
# CI/CD: injected via the RAILS_MASTER_KEY env var (GitHub Secret) on the deploy step.
# Local: falls back to config/master.key (gitignored — absent from a CI checkout, so the
# env var must win there or boot-time credential decryption fails).
# 🔴 Form: `$(printf '%s' "\${RAILS_MASTER_KEY:-$(cat …)}")`, NOT the bare `${…:-…}`. Measured
# 2026-09-02 through Kamal::Secrets: Dotenv's variable pass reads `${RAILS_MASTER_KEY` and
# leaves the rest as literal, so the bare form delivered `<key>:-}` to every container
# (the fallback command ran, printed nothing, and the wrapper stayed) — a PRESENT, non-empty,
# WRONG master key that no presence gate can see. Canopy survived it only because nothing
# there decrypts credentials (.dockerignore keeps credentials.yml.enc out of the image);
# production would have hit it the first time any `ENV[..].presence || credentials` fallback
# fired. The `$( … )` form is evaluated by /bin/sh (Kamal's inline command substitution,
# nested `$( )` allowed by its recursive regex); pinned by spec/deploy/kamal_secrets_parse_spec.rb.
RAILS_MASTER_KEY=$(printf '%s' "\${RAILS_MASTER_KEY:-$(cat config/master.key 2>/dev/null)}")
# [SEC.22] SECRET_KEY_BASE must travel SEPARATELY from RAILS_MASTER_KEY, and the reason
# is the image, not the policy: `.dockerignore` deliberately keeps credentials.yml.enc
# out of the PUBLIC GHCR image, so the master key inside the container has nothing to
# decrypt — Rails then raises «Missing `secret_key_base` for 'production'» at boot
# (measured run 33499749733, the first container that ever started). Value is the same
# one credentials carry, so sessions signed before and after a Phase-2 drop stay valid.
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Google Artifact Registry auth — short-lived OAuth2 access token (WIF keyless, INF.22),
# NOT a JSON key. Registry username is oauth2accesstoken (config/deploy.yml). In CI the
# deploy workflow's auth step (token_format: access_token) outputs it. Locally:
#   export GCP_ARTIFACT_REGISTRY_KEY=$(gcloud auth print-access-token)
# before kamal deploy. Keyless throughout — no static-key exception exists [OPS.37].
GCP_ARTIFACT_REGISTRY_KEY=$GCP_ARTIFACT_REGISTRY_KEY

# Cloud SQL PostgreSQL password (component style — config/database.yml).
# host/user are non-secret and live in config/deploy.yml env.clear; only the
# password is a secret. Set via ENV or password manager before `kamal deploy`.
# POSTGRES_PASSWORD=<cloud-sql-password>
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Redis connection URL (Upstash — serverless Redis with TLS public endpoints).
# Replaces GCP Memorystore (removed with the pivot that created it).
# Sign up at https://upstash.com/ → Create Redis database → Copy connection URL.
# Format: rediss://default:password@endpoint.upstash.io:6379
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379/0
REDIS_URL=$REDIS_URL

# Kredis distributed locks (Web3 nonce management) read REDIS_URL as-is via
# config/redis/shared.yml — no separate secret needed. Upstash exposes ONE logical
# database [INF.22], so the consumers share a keyspace and are separated by key
# prefix (`silken:*`), not by a DB number. Do NOT re-add KREDIS_REDIS_URL here: an
# empty inject (""), unlike an unset var, is truthy to ENV.fetch and would override
# that with garbage → Kredis connects to "" and crashes. Set it only to point Kredis
# at a *different* Redis INSTANCE — which is the one way to get isolation from
# memory pressure, since a prefix separates names and never eviction.

# Sentry DSN for error tracking in production.
# Without this, Sentry is inert and no errors are reported.
# Set via environment variable from your Sentry project settings.
SENTRY_DSN=$SENTRY_DSN

# Turbo signed-stream key [SEC.25] — HMAC імен Turbo-стрімів. Unset ⇒ гем деривує з
# secret_key_base, і тоді ротація на витік тягне ВСІ сесії/CSRF/ActiveStorage разом.
TURBO_SIGNED_STREAM_KEY=$TURBO_SIGNED_STREAM_KEY

# Grafana Cloud remote_write — consumed by the `alloy` accessory (config/deploy.yml).
# Runtime tier, not boot-critical: without them Alloy pushes nowhere and the app is
# unaffected, so the deploy workflows WARN rather than gate. Grafana Cloud → Stack →
# Prometheus → "Send Metrics" gives all three (URL / instance id / API token).
GRAFANA_REMOTE_WRITE_URL=$GRAFANA_REMOTE_WRITE_URL
GRAFANA_REMOTE_WRITE_USERNAME=$GRAFANA_REMOTE_WRITE_USERNAME
GRAFANA_REMOTE_WRITE_TOKEN=$GRAFANA_REMOTE_WRITE_TOKEN

# HKDF master key for hardware provisioning (AES key derivation).
# Boot-critical: config/initializers/master_key_strength_check.rb raises SecurityError
# in production when absent/weak — Puma crashes before the accept loop (no lab fallback).
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
PROVISIONING_MASTER_KEY=$PROVISIONING_MASTER_KEY

# ActiveRecord Encryption keys [SEC.22] — decrypt hardware_keys + identities columns.
# Boot-critical: active_record_encryption_keys_check.rb raises without them (>=32 chars each).
# Generate all three: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT

# SMTP credentials for Action Mailer [ARCH.60]. Secret-by-default because on several
# ESPs the "username" IS the credential (Postmark server token; SES access-key id).
# NOT boot-critical themselves — mail_transport_check.rb demands MAIL_FROM + SMTP_ADDRESS
# (env.clear), because a relay that needs no auth is a legitimate setup; a wrong password
# surfaces as a failed Sidekiq job, which is loud now that the transport exists at all.
SMTP_USER_NAME=$SMTP_USER_NAME
SMTP_PASSWORD=$SMTP_PASSWORD

# Telegram bot token [ARCH.60] — optional channel: the transport no-ops when unset
# (format-checked, so an unmapped "" or the placeholder reads as "off", never as live).
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN

# HMAC-SHA256 secret for verifying X-Chainlink-Signature header in oracle callbacks.
# (On-chain dispatch secrets removed — ARCH.53 demote; callback endpoint stays live.)
CHAINLINK_HMAC_SECRET=$CHAINLINK_HMAC_SECRET

# HMAC-SHA256 secret for X-Helium-Signature on POST /api/v1/telemetry/helium (Queen SOS,
# ARCH.34). Under WEB3_STRICT_MODE=true the controller raises SecurityError per-request
# when absent. Same recipe: SecureRandom.hex(32); also entered in Helium Console.
HELIUM_WEBHOOK_SECRET=$HELIUM_WEBHOOK_SECRET

# --- Web3 oracle keys (dual-key split, B-02 resolved) ----------------------
# ORACLE_PRIVATE_KEY (legacy shared fallback) is fully RETIRED (INF.22): no code
# reads it, and Security::Web3NetworkGuard refuses a value under that name.
# Every signer has a dedicated key. Aux signers (ORACLE_ETHERISC/PURO/KLIMA_
# PRIVATE_KEY) are activation-gated lazy keys — injected when their path goes
# live, never listed here (unprovisioned-but-listed = present-empty "" → raise).
# Dedicated Celo cUSD signer (ARCH.50 blast-radius isolation; no fallback).
ORACLE_CELO_PRIVATE_KEY=$ORACLE_CELO_PRIVATE_KEY
# Holds MINTER_ROLE on SCC & SFC contracts (BlockchainMintingService:107).
ORACLE_MINTER_PRIVATE_KEY=$ORACLE_MINTER_PRIVATE_KEY
# Holds SLASHER_ROLE on SCC & SFC contracts (BlockchainBurningService:58).
ORACLE_SLASHER_PRIVATE_KEY=$ORACLE_SLASHER_PRIVATE_KEY
# Separate wallet for weekly Ethereum L1 state-root anchor (Ethereum::StateAnchorService:147).
ETHEREUM_ANCHOR_PRIVATE_KEY=$ETHEREUM_ANCHOR_PRIVATE_KEY

# --- Origin TLS (INF.4) ----------------------------------------------------
# Cloudflare Origin CA pair consumed by `config/deploy.yml` `proxy.ssl` — Kamal takes SECRET
# NAMES there, so both must resolve HERE or kamal-proxy boots without a certificate and every
# request through Cloudflare's Full (strict) answers 521/525.
# ⚠️ The certificate half is PUBLIC by nature (it is presented in every TLS handshake); it lives
# in the secret store only because that is Kamal's delivery channel for `proxy.ssl`. The KEY half
# is a real secret — generated locally, never sent to Cloudflare (CF signed only the CSR).
TLS_ORIGIN_CERT_PEM=$TLS_ORIGIN_CERT_PEM
TLS_ORIGIN_KEY_PEM=$TLS_ORIGIN_KEY_PEM

# --- RPC endpoints (SSOT names referenced by Web3::RpcConnectionPool) -----
ALCHEMY_POLYGON_RPC_URL=$ALCHEMY_POLYGON_RPC_URL
ALCHEMY_ETHEREUM_RPC_URL=$ALCHEMY_ETHEREUM_RPC_URL
SOLANA_RPC_URL=$SOLANA_RPC_URL
# Celo rewards (CELO_RPC_URL) — separate from ALCHEMY_*.
CELO_RPC_URL=$CELO_RPC_URL

# --- Solana minting (Solana::MintingService raises without these) ----------
SOLANA_WALLET_KEYPAIR=$SOLANA_WALLET_KEYPAIR
SOLANA_FEE_PAYER_PUBKEY=$SOLANA_FEE_PAYER_PUBKEY
SOLANA_FEE_PAYER_TOKEN_ACCOUNT=$SOLANA_FEE_PAYER_TOKEN_ACCOUNT
SOLANA_USDC_MINT_ADDRESS=$SOLANA_USDC_MINT_ADDRESS
