#!/usr/bin/env ruby
# SPDX-License-Identifier: AGPL-3.0-or-later
# frozen_string_literal: true

# = ===================================================================
# 🌲 FOREST SIMULATOR — Digital Twin (Queen Gateway Emulator)
# = ===================================================================
# Симулятор «Цифрового Близнюка» для тестування CoAP/UDP конвеєру:
#   CoAP Listener → UnpackTelemetryWorker → TelemetryUnpackerService
#
# Генерує реалістичну телеметрію від дерев-Солдатів, шифрує AES-256-CBC
# та відправляє через CoapClient як справжня Королева (Gateway).
#
# Використання:
#   chmod +x bin/forest_simulator
#   bin/forest_simulator
#
# Вимоги:
#   - Запущений CoAP Listener (lib/daemons/coap_listener)
#   - Дані в БД (rails db:seed)
# = ===================================================================

# ⚠️ Гард Web3 класифікує цей скрипт як **web** (не Sidekiq, не coap_listener), тож він
# ВИМАГАЄ `CARBON_COIN_CONTRACT_ADDRESS` — хоч money-path тут не торкається жодного разу.
# Це заявлений over-refuse, і вихід один: `SILKENNET_SKIP_WEB3_NETWORK_GUARD=1 bin/forest_simulator …`
# [INF.27, 2026-09-01 — виняток за $PROGRAM_NAME свідомо ВІДХИЛЕНО: --drain провіжнить
#  дерева й ганяє справжніх воркерів, тобто чисто поза периметром не лежить].
require_relative "../config/environment"

# --- КОНСТАНТИ СИМУЛЯЦІЇ ---
BATCH_SIZE_RANGE = (5..15)
SLEEP_RANGE = (3..8)

# [E.64] Вікно перезаряду EBFC, з якого береться `delta_t`. Доти стояло `rand(5..120)`,
# і воно вироджувало метаболічний канал: `metabolic_health` насичується вже на 600 с,
# тож КОЖЕН пакет ніс `growth_points = 31` — демо показувало вічний максимум емісії.
# Межі — ті самі placeholder-пороги, що чекають bench-кривої (`03_04 §4.3`), тож смуга
# балів виходить повна 5..31. ⛔ Сентинел `DELTA_T_UNKNOWN_S = 0` симулятор НЕ шле
# свідомо: його віддає вузол, у якого ще не піднявся RTC (FW.49), а тут провіжинений
# флот із теплим ланцюгом — вигадувати йому відмову міряти означало б фабрикувати стан.
RECHARGE_RANGE = (SilkenNet::Attractor::DELTA_T_FAST_S..SilkenNet::Attractor::DELTA_T_SLOW_S)
# [OPS.37] Ціль — параметр, не літерал: на canopy симулятор біжить у job-контейнері app-хоста,
# а демон-інтейк живе на анкері (INF.17), тож loopback там мовчить. Імʼя навмисно НЕ
# `COAP_HOST` — та змінна вже зайнята UDP-пробою адмін-панелі (`api.silkennet.com`, env.clear);
# усередині VPC ціль = ПРИВАТНА IP анкера (`terraform output -raw ingress_private_ip`,
# firewall `allow_internal`), а не публічне імʼя. Дефолт лишає локальний сценарій незмінним.
COAP_HOST = ENV.fetch("SIMULATOR_COAP_URL", "coap://127.0.0.1:5683")
COAP_TIMEOUT = 2

$stdout.sync = true

puts ""
puts "🌲🌲🌲  SILKEN FOREST SIMULATOR — Digital Twin  🌲🌲🌲"
puts "=" * 56
puts "📡 Мета: #{COAP_HOST}"
puts "⏱️  Інтервал: #{SLEEP_RANGE} секунд між батчами"
puts "📦 Розмір: #{BATCH_SIZE_RANGE} дерев / батч"
puts "=" * 56
puts ""

# Кешуємо останню активну firmware для дерев (1 запит)
latest_firmware_id = BioContractFirmware.active
                                        .where(target_hardware_type: "Tree")
                                        .order(id: :desc)
                                        .pick(:id) || 0

puts "🔧 Актуальна прошивка: #{latest_firmware_id.zero? ? 'не знайдено' : "##{latest_firmware_id}"}"
puts ""

# [E.64] Модель Солдата — ОДИН дім, `lib/hil/soldier_node.rb` (там і повна врізка про
# те, чому `rand` тут був не «спрощенням», а спростуванням DCI за побудовою, і три
# оголошені стелі емуляції). Тут — лише виклик: скрипт тонкий, бо інакше правило
# лишається без носія, а спеки в `bin/` не буває.
soldier = Hil::SoldierNode.new

loop do
  # 1. ВИБІР КОРОЛЕВИ (Gateway з HardwareKey)
  gateway = Gateway.joins(:hardware_key).order("RANDOM()").first

  unless gateway
    puts "⚠️  Немає жодного шлюзу з HardwareKey. Запустіть: rails db:seed"
    sleep 5
    next
  end

  hw_key = gateway.hardware_key

  # 2. ВИБІР СОЛДАТІВ (Активні дерева з кластеру Королеви)
  # [E.64] `includes(:hardware_key)` — не оптимізація «про запас»: кожне дерево тепер
  # читає власний `K_seed` для Lorenz-ланцюга, тож без preload'у це N+1 на КОЖЕН батч.
  trees = if gateway.cluster
            gateway.cluster.trees.active.includes(:hardware_key).order("RANDOM()").limit(rand(BATCH_SIZE_RANGE))
  else
            Tree.active.includes(:hardware_key).order("RANDOM()").limit(rand(BATCH_SIZE_RANGE))
  end

  if trees.empty?
    puts "⚠️  #{gateway.uid}: немає активних дерев у кластері. Пропуск..."
    sleep rand(SLEEP_RANGE)
    next
  end

  puts "👑 Queen #{gateway.uid} готує батч із #{trees.size} Солдатів..."

  # 3. ПАКУВАННЯ + 4. AES-256-CBC — reuse TelemetryBatchFactory (One-Home:
  #    chunk-layout і uplink-шифр авто-адаптуються під wire-rev через
  #    PAYLOAD_FORMAT; тут лишається тільки реалістична генерація значень).
  batch_data = "".b

  trees.each do |tree|
    did_int     = tree.did.delete_prefix("SNET-").to_i(16)
    voltage     = rand(3200..4800)          # мВ (VDDA — на Z не впливає, E.63/FW.50)
    temperature = rand(-10..45)             # °C (сире wire-значення = DCI-якір, FW.57 F2)
    acoustic    = rand(0..200)              # кваліфіковані події від останнього TX
    metabolism  = rand(RECHARGE_RANGE)      # delta_t перезаряду EBFC, сек
    rssi        = rand(50..90)              # інвертований RSSI (wire-значення)
    ttl         = rand(1..7)                # mesh hops

    # [E.64] СТАТУС І БАЛИ ОБЧИСЛЮЮТЬСЯ, НЕ ГЕНЕРУЮТЬСЯ. `strict: false` — щоб одне
    # непровіжинене дерево не вбивало батч; але воно НЕ ховається (рядок нижче).
    reading = soldier.read(tree, temperature_c: temperature, acoustic: acoustic,
                                 metabolism_s: metabolism, voltage_mv: voltage,
                                 strict: false)
    if reading.nil?
      puts "   ⛔ #{tree.did}: немає провіженого K_seed — вузол не може обчислити Z. Пропуск (SEC.11)."
      next
    end

    batch_data << SilkenNet::LoadTest::TelemetryBatchFactory.chunk(
      did_int: did_int, rssi: rssi, voltage_mv: voltage, temperature_c: temperature,
      acoustic: acoustic, metabolism_s: metabolism, growth_points: reading.growth_points,
      ttl: ttl, bio_status: reading.bio_status, firmware_id: latest_firmware_id
    )

    puts "   🌳 #{tree.did} | #{voltage}mV #{temperature}°C 🎙️#{acoustic} | " \
         "Z=#{reading.z.round(2)}#{reading.cold_start ? ' ❄️cold' : ''} " \
         "bio:#{reading.bio_status} grow:#{reading.growth_points} TTL:#{ttl} RSSI:-#{rssi}"
  end

  if batch_data.empty?
    puts "   ⚠️  Батч порожній — жодне дерево не має K_seed. Пропуск."
    sleep rand(SLEEP_RANGE)
    next
  end

  final_payload = SilkenNet::LoadTest::TelemetryBatchFactory.encrypt(batch_data, hw_key.binary_key)

  puts "   🔐 Зашифровано: #{batch_data.bytesize}б → #{final_payload.bytesize}б (IV:16 + CT)"

  # 5. ПЕРЕДАЧА ЧЕРЕЗ CoAP
  url = "#{COAP_HOST}/telemetry/batch/#{gateway.uid}"

  begin
    response = CoapClient.put(url, final_payload, timeout: COAP_TIMEOUT)
    puts "   ✅ Відправлено → #{url} [#{response&.class_string || 'OK'}]"
  rescue CoapClient::NetworkError => e
    puts "   📡 Мережа: #{e.message} (CoAP listener запущено?)"
  rescue CoapClient::Error => e
    puts "   ❌ CoAP помилка: #{e.message}"
  rescue StandardError => e
    puts "   🛑 Збій: #{e.class} — #{e.message}"
  end

  delay = rand(SLEEP_RANGE)
  puts "   ⏳ Наступний батч через #{delay}с..."
  puts ""

  sleep delay
rescue Interrupt
  puts ""
  puts "🛑 Симуляція зупинена оператором. Ліс засинає..."
  exit 0
rescue StandardError => e
  puts "🚨 Критична помилка: #{e.message}"
  puts e.backtrace.first(5).join("\n")
  sleep 5
end
