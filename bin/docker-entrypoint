#!/bin/bash -e

# If running the rails server then create or migrate existing database
#
# 🔒 IN-ENTRYPOINT IS A RATIFIED CHOICE, NOT AN OVERSIGHT — and the condition under
# which it stops being correct is `web count >= 2` [INF.22]. With a single web
# replica exactly one process reaches this line, so migrating here is safe and
# cheapest. Add a second replica and it becomes a race: N containers boot in
# parallel and all run `db:prepare` against the same database. THEN the migration
# step must move OUT of the entrypoint into a separate one-shot (`kamal app exec`
# pre-deploy, or a dedicated release role) and this branch becomes a no-op.
# ⚠️ Recorded here rather than in the tracker because this is where the reader
# stands: until 2026-08-31 the ratification existed ONLY as a tracker leg, so the
# file itself gave no sign that its shape was chosen rather than defaulted.
# 🔴 [2026-09-01] `db:prepare` на НЕІСНУЮЧІЙ базі = create + schema:load + load_seed,
# тобто той самий `db:setup` під іншим імʼям. Два наслідки, обидва названі явно:
#  (а) на `production` `db/seeds.rb` тепер fail-closed за слотом і робить `abort` —
#      під `set -e` це crash-loop контейнера ЗАМІСТЬ `delete_all` по 27 моделях.
#      Тобто гучна відмова тут КОРЕКТНА, і прод-база піднімається bootstrap-таскою
#      (склад — `00_07` OPS.38), а не цією гілкою;
#  (б) на dev/canopy сід проходить — але `db:prepare` не лишає місця прогнати
#      `PartitionMaintenanceWorker` МІЖ schema:load і seed, а сід датує записи
#      минулим (73.hours.ago). Порядок і ціна — `06_01` крок 7 + `06_06 §5.5`.
#  (в) 🔴 [2026-09-02, перший бут canopy] `db:prepare` НЕ атомарний: create → schema:load →
#      seed — і впалий сід лишає базу «існуючою», тож ПІСЛЯ рестарту (Docker
#      `unless-stopped`, RestartCount=1) друга спроба лише мігрує: без сіду, без
#      schema:load, і контейнер стає healthy на `/up` з напівзасіяним слотом
#      (`SystemParameter`=1, `User`=0). Ліки: staging — `db:drop` трьох баз і
#      редеплой (чесний холодний шлях); прод — bootstrap-таска (OPS.38), не ця гілка.
#      Того ж дня виміряно й ПРИЧИНУ падіння сіду: `schema_format = :sql`, тож для
#      конфігів `cache`/`cable` Rails шукає `db/{cache,cable}_structure.sql` (деривація
#      `HashConfig#schema_dump`), а в репо лежали лише `*_schema.rb` від інсталерів —
#      обидві бази створювались ПОРОЖНІМИ, і `Rails.cache` у сіді падав на
#      `solid_cache_entries`. Носій — spec/db/solid_structure_files_spec.rb.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
else
  # Non-server processes (Sidekiq job, CoAP daemon) must not race the web's
  # db:prepare on a cold FIRST deploy — Kamal starts every role in parallel
  # (there is no depends_on), and a worker touching a not-yet-migrated table
  # burns retries / lands money-path jobs in the DeadSet before the schema
  # exists. Wait for schema_migrations on the primary, fail loud after 60s —
  # the container restarts and the gate converges once web finishes.
  if [ -n "$POSTGRES_HOST" ]; then
    schema_ready=false
    for i in $(seq 1 60); do
      if PGPASSWORD="$POSTGRES_PASSWORD" psql -h "$POSTGRES_HOST" -U "$POSTGRES_USER" \
           -d "${POSTGRES_DATABASE:-silken_net_production}" -tAc \
           "SELECT 1 FROM schema_migrations LIMIT 1" >/dev/null 2>&1; then
        schema_ready=true
        break
      fi
      sleep 1
    done
    if [ "$schema_ready" != "true" ]; then
      echo "[entrypoint] FATAL: schema_migrations not reachable after 60s — the web service's db:prepare has not completed yet (cold-deploy race). Aborting instead of burning worker retries." >&2
      exit 1
    fi
  fi
fi

exec "${@}"
