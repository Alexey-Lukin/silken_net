#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# [UNI.20] DCO sign-off carrier — at the MOMENT OF ACTION.
#
# Why a hook and not a note: the rule "always `git commit -s`" was written in two
# places and relapsed twice anyway — three unsigned commits, then six. Per-commit
# discipline is O(n) chances to forget; this is the O(1) point where forgetting
# stops mattering. `dco.yml` does NOT cover it: that gate fires on INBOUND pull
# requests, and the maintainer's authorized direct pushes to `main` never open one.
#
# Deliberately DCO-only. The full suite and the docs battery are the founder's
# pre-push discipline and are CI-gated; putting ~1.5 min of tests on every push
# buys a bypass habit, which costs more than it saves.
#
# Enabled by `git config core.hooksPath .githooks` (set by bin/setup; re-run it
# after a fresh clone). Emergency bypass: `git push --no-verify`.

# [DOC-T.64] These two used to be `|| exit 0` — a silent surrender in the one hook
# whose whole point is that forgetting must stop mattering. Losing the checker (a bad
# merge, a stray `git rm`, a hooksPath pointing at another tree) would have disabled
# DCO with no output at all, which is exactly the "the check never ran" state the
# block at the bottom of this file already refuses to confuse with a verdict.
if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "pre-push BLOCKED — not inside a git work tree, so DCO could not be checked."
  echo "This is NOT a DCO verdict: the check never ran, so its silence means nothing."
  echo "(Emergency bypass: git push --no-verify — but that skips DCO entirely.)"
  exit 1
fi
if [ ! -f "$root/scripts/dco_check.rb" ]; then
  echo "pre-push BLOCKED — scripts/dco_check.rb is missing, so DCO could not be checked."
  echo "This is NOT a DCO verdict: the check never ran, so its silence means nothing."
  echo "Restore the file (git checkout -- scripts/dco_check.rb) and re-push."
  echo "(Emergency bypass: git push --no-verify — but that skips DCO entirely.)"
  exit 1
fi

# 🔴 Resolve a ruby that can RUN the check, instead of taking whatever PATH
# offers. Measured 2026-08-09, live: the shell's PATH led with a gemset removed
# by the 4.0.5→4.0.6 bump, so `ruby` was macOS 2.6, `dco_check.rb` failed to
# PARSE (shorthand `range:` is 3.1+), and this hook printed "commits lack a
# Signed-off-by trailer" — its own default — for commits it never examined.
# The hook could not tell "the check said no" from "the check never ran", so it
# reported the only sentence it had. Verdict happened to be right that day;
# the grounds were fabricated, and every push was blocked regardless of DCO.
# Same fix and same reason as `.claude/hooks/memory_gate.sh` (00_06 §3, DARK).
for _rb in "${DCO_RUBY:-}" "$(command -v ruby 2>/dev/null)" \
           "$HOME/.rvm/rubies/default/bin/ruby" /usr/bin/ruby; do
  [ -n "$_rb" ] && [ -x "$_rb" ] || continue
  "$_rb" -c "$root/scripts/dco_check.rb" >/dev/null 2>&1 && break
  _rb=""
done

if [ -z "$_rb" ]; then
  echo "pre-push BLOCKED — no ruby able to parse scripts/dco_check.rb"
  echo "This is NOT a DCO verdict: the check never ran, so its silence means nothing."
  echo "Fix the toolchain (rvm-heal), or set DCO_RUBY=/path/to/ruby."
  echo "(Emergency bypass: git push --no-verify — but that skips DCO entirely.)"
  exit 1
fi

if ! "$_rb" "$root/scripts/dco_check.rb"; then
  echo
  echo "pre-push BLOCKED — commits above lack a matching Signed-off-by trailer."
  echo "Fix in place:  git rebase --signoff origin/main"
  echo "Then re-push.  (Emergency bypass: git push --no-verify)"
  exit 1
fi
