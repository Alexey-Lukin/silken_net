#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# [UNI.20] DCO sign-off carrier — at the MOMENT OF ACTION.
#
# Why a hook and not a note: the rule "always `git commit -s`" was written in two
# places and relapsed twice anyway — three unsigned commits, then six. Per-commit
# discipline is O(n) chances to forget; this is the O(1) point where forgetting
# stops mattering. `dco.yml` does NOT cover it: that gate fires on INBOUND pull
# requests, and the maintainer's authorized direct pushes to `main` never open one.
#
# SCOPE RULE — the line is the COST, not the name. This hook carries DCO plus
# any check that is deterministic and CHEAP (each block states its MEASURED
# price). The full suite and the docs battery stay out: at ~1.5 min they buy a
# `--no-verify` habit, and then nothing at all stands on this path. `00_06 §3`
# records the same ground for DCO — «повна сюїта на кожному push купує звичку
# обходити хук». Read "deliberately DCO-only" in older notes as that cost rule;
# it was never a rule about the number of checks (I18N.4, 2026-08-13).
#
# Enabled by `git config core.hooksPath .githooks` (set by bin/setup; re-run it
# after a fresh clone). Emergency bypass: `git push --no-verify`.

# [DOC-T.64] These two used to be `|| exit 0` — a silent surrender in the one hook
# whose whole point is that forgetting must stop mattering. Losing the checker (a bad
# merge, a stray `git rm`, a hooksPath pointing at another tree) would have disabled
# DCO with no output at all, which is exactly the "the check never ran" state the
# block at the bottom of this file already refuses to confuse with a verdict.
if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "pre-push BLOCKED — not inside a git work tree, so DCO could not be checked."
  echo "This is NOT a DCO verdict: the check never ran, so its silence means nothing."
  echo "(Emergency bypass: git push --no-verify — but that skips DCO entirely.)"
  exit 1
fi
if [ ! -f "$root/scripts/dco_check.rb" ]; then
  echo "pre-push BLOCKED — scripts/dco_check.rb is missing, so DCO could not be checked."
  echo "This is NOT a DCO verdict: the check never ran, so its silence means nothing."
  echo "Restore the file (git checkout -- scripts/dco_check.rb) and re-push."
  echo "(Emergency bypass: git push --no-verify — but that skips DCO entirely.)"
  exit 1
fi

# 🔴 Resolve a ruby that can RUN the check, instead of taking whatever PATH
# offers. Measured 2026-08-09, live: the shell's PATH led with a gemset removed
# by the 4.0.5→4.0.6 bump, so `ruby` was macOS 2.6, `dco_check.rb` failed to
# PARSE (shorthand `range:` is 3.1+), and this hook printed "commits lack a
# Signed-off-by trailer" — its own default — for commits it never examined.
# The hook could not tell "the check said no" from "the check never ran", so it
# reported the only sentence it had. Verdict happened to be right that day;
# the grounds were fabricated, and every push was blocked regardless of DCO.
# Same fix and same reason as `.claude/hooks/memory_gate.sh` (00_06 §3, DARK).
for _rb in "${DCO_RUBY:-}" "$(command -v ruby 2>/dev/null)" \
           "$HOME/.rvm/rubies/default/bin/ruby" /usr/bin/ruby; do
  [ -n "$_rb" ] && [ -x "$_rb" ] || continue
  "$_rb" -c "$root/scripts/dco_check.rb" >/dev/null 2>&1 && break
  _rb=""
done

if [ -z "$_rb" ]; then
  echo "pre-push BLOCKED — no ruby able to parse scripts/dco_check.rb"
  echo "This is NOT a DCO verdict: the check never ran, so its silence means nothing."
  echo "Fix the toolchain (rvm-heal), or set DCO_RUBY=/path/to/ruby."
  echo "(Emergency bypass: git push --no-verify — but that skips DCO entirely.)"
  exit 1
fi

if ! "$_rb" "$root/scripts/dco_check.rb"; then
  echo
  echo "pre-push BLOCKED — commits above lack a matching Signed-off-by trailer."
  echo "Fix in place:  git rebase --signoff origin/main"
  echo "Then re-push.  (Emergency bypass: git push --no-verify)"
  exit 1
fi

# [I18N.4] i18n parity band — the second carrier on this hook.
#
# `i18n_check` (ci.yml) was the ONLY CI lane with no local carrier of any kind:
# no binstub, no line in CLAUDE.md §3, nothing. Its price was paid for real —
# `main` stood red from 10ae12bd, and two subsequent green runs MASKED it,
# because the job is gated on `ruby||ci`, so docs-only and .sh commits never
# even started it.
#
# COST, measured on this tree 2026-08-13 (not estimated): missing 2.9 s +
# check-consistent-interpolations 0.5 s + check-normalized 0.6 s ≈ 4 s. Two
# orders of magnitude under the suite the scope rule above refuses.
#
# 🔴 All three DISCRIMINATE by exit code — mutation-verified 2026-08-13, one
# mutant per mechanism (a batch would let one mask another): a key present in
# the base locale deleted from `uk` → `missing` exits 1; `%{current}` renamed
# to `%{cur}` → `check-consistent-interpolations` exits 1; a key placed out of
# alphabetical order → `check-normalized` exits 1; a syntactically broken YAML
# → all three exit 78. The long-standing claim that `check-normalized` "always
# exits 0 (upstream quirk)" was true of an older gem and is DEAD in 1.1.2 —
# the gem returns `:exit1 unless non_normalized.empty?`
# (lib/i18n/tasks/command/commands/data.rb). Grepping its prose instead is now
# strictly worse: it pins an English sentence a Dependabot bump may reword.
#
# NOT-RUN ⊥ FAILED (§Guard-craft #47): a non-zero code alone cannot tell "the
# locales are broken" from "the gem never ran", and an unrunnable check must
# never read as a verdict. The fitness probe therefore sits on the FAILURE path
# only — the green path must not pay for a diagnosis nobody reads, while on the
# red path its ~0.5 s is free.
_i18n_log=$(mktemp)
trap 'rm -f "$_i18n_log"' EXIT INT TERM

for _cmd in missing check-consistent-interpolations check-normalized; do
  ( cd "$root" && bundle exec i18n-tasks "$_cmd" ) >"$_i18n_log" 2>&1 && continue

  cat "$_i18n_log"
  echo

  if ! ( cd "$root" && bundle exec i18n-tasks --version ) >/dev/null 2>&1; then
    echo "pre-push BLOCKED — i18n-tasks could not RUN (bundler or the gem is unavailable)."
    echo "This is NOT an i18n verdict: the check never ran, so its silence means nothing."
    echo "Fix the toolchain (bundle install — or rvm-heal if the gemset is gone), then re-push."
    echo "(Emergency bypass: git push --no-verify — but that skips DCO as well.)"
    exit 1
  fi

  echo "pre-push BLOCKED — \`i18n-tasks $_cmd\` reports violations (listed above)."
  echo "Fix:  bundle exec i18n-tasks normalize          # for check-normalized"
  echo "      edit config/locales/**                    # for missing / interpolations"
  echo "Then re-push.  (Emergency bypass: git push --no-verify)"
  exit 1
done

# [OPS.28] Path-gated tool checks — the third carrier on this hook.
#
# Інвентар «CI-крок ⊥ локальний носій» знайшов пʼять джоб, чий носій слабший за
# CI-крок. Форму обрано не на смак, а ЗАПИСАНИМ правилом цього файлу («межа — ЦІНА»),
# застосованим до виміряних чисел (2026-08-23, це дерево, за 30 днів історії):
#
#   actionlint   тригер `.github/workflows/**` — 63 коміти (~2/добу), ЦІНА 1.28 с
#                → найчастіший і найдешевший; я двічі за одну годину забув його
#                  прогнати, тобто «памʼятати команду» вже виміряно як НЕ-носій.
#   alloy-гейт   тригер `deploy/**` — 11 комітів, ЦІНА ~40 мс
#   cppcheck     тригер `firmware/**` — 13 комітів (~0.4/добу), ЦІНА 6.7 с
#                → дорожче за весь наявний бюджет хука, але спрацьовує рідко;
#                  амортизовано ~87 с/місяць проти ~5–10 хв round-trip на червоний CI.
#                🔒 СТЕЛЯ, названа: локальний cppcheck ставить Homebrew, а CI бере
#                  його з apt образу ubuntu-24.04 — версії РІЗНІ. Тож зелене тут не є
#                  твердженням про CI-крок (і навпаки): блок ловить те, що ловлять
#                  ОБИДВІ версії, а розбіжність лишається за CI. Це не вада — це
#                  причина, чому блок не має права читатись як заміна джобі.
#   importmap    тригер — 0 комітів за 30 днів → свідомо лишається CI-only:
#                  носій без пускача є декорацією, і його ціну ніхто б не побачив.
#
# Кожен блок ПЛАТИТЬ ЛИШЕ КОЛИ ЙОГО ШЛЯХ ЗМІНИВСЯ, тож звичайний push коштує
# рівно стільки, скільки коштував (DCO + i18n ≈ 4 с).
#
# ⚠️ NOT-RUN тут поводиться ІНАКШЕ, ніж у двох блоках вище, і різниця навмисна.
# Там відсутній інструмент БЛОКУЄ, бо ті перевірки є мандатом самого хука. Тут
# інструмент — девелоперський, і блокувати push через його відсутність означало б
# зробити свіжий clone непушабельним. Тож NOT-RUN друкує ГУЧНУ ноту, що називає
# себе не-вердиктом, і пропускає. Це не «тиха капітуляція» DOC-T.64 (`|| exit 0`
# без жодного виводу): там мовчала сама відсутність, тут вона названа.
_changed=$(git diff --name-only origin/main...HEAD 2>/dev/null)

if printf '%s\n' "$_changed" | grep -q '^\.github/workflows/'; then
  if command -v actionlint >/dev/null 2>&1; then
    if ! ( cd "$root" && actionlint .github/workflows/*.yml ); then
      echo
      echo "pre-push BLOCKED — actionlint reports violations in .github/workflows/** (above)."
      echo "Fix:  actionlint .github/workflows/*.yml"
      echo "Then re-push.  (Emergency bypass: git push --no-verify)"
      exit 1
    fi
  else
    echo "pre-push NOTE — workflows changed but actionlint is not installed locally."
    echo "  This is NOT a verdict: the check never ran. CI will run it (job \`workflow_lint\`)."
    echo "  Install:  brew install actionlint"
  fi
fi

if printf '%s\n' "$_changed" | grep -q '^deploy/'; then
  for _script in deploy_secret_scan; do
    [ -f "$root/scripts/$_script.rb" ] || continue
    if ! ( cd "$root" && "$_rb" "scripts/$_script.rb" ); then
      echo
      echo "pre-push BLOCKED — \`scripts/$_script.rb\` reports violations (above)."
      echo "Then re-push.  (Emergency bypass: git push --no-verify)"
      exit 1
    fi
  done
fi

if printf '%s\n' "$_changed" | grep -qE '^firmware/.*\.(c|h)$'; then
  if [ -x "$root/firmware/scripts/cppcheck.sh" ] && command -v cppcheck >/dev/null 2>&1; then
    if ! ( cd "$root" && sh firmware/scripts/cppcheck.sh ); then
      echo
      echo "pre-push BLOCKED — cppcheck reports findings in firmware/** (above)."
      echo "Fix:  sh firmware/scripts/cppcheck.sh"
      echo "Then re-push.  (Emergency bypass: git push --no-verify)"
      exit 1
    fi
  else
    echo "pre-push NOTE — firmware C changed but cppcheck (or its script) is unavailable."
    echo "  This is NOT a verdict: the check never ran. CI will run it (job \`firmware_lint\`)."
  fi
fi

# [OPS.28] brakeman — четвертий блок. ⚖️ ПРИЙНЯТО 2026-08-28 (делеговано founder'ом).
#
# 🔴 Підстава — НЕ «ще одна корисна перевірка», а АСИМЕТРІЯ до вже ратифікованого
# сусіда. Критерій цього файлу — ЦІНА; за ним i18n-трійка їде БЕЗУМОВНО за ~4 с.
# brakeman коштує МЕНШЕ і біжить РІДШЕ, тож відмовити йому означало б судити його
# суворіше, ніж те, що вже їде — це не рішення, а недогляд.
#
# ЦІНА, виміряна на цьому дереві 2026-08-28 (три прогони, не оцінка):
#   bin/brakeman --no-pager   3.41 / 3.46 / 4.05 с  → ~3.5 с
#   тригер `app|lib|config`   427 комітів за 30 днів із 1316 (32%)
# ⚠️ Пункт трекера казав «1.67 с» — перемір дав удвічі більше. Число тут з прогону.
#
# ЧОМУ КОРІНЬ НЕ ЛІКУЄТЬСЯ, і чому У-ВЕЙ тут не звільняє (перевірено в джерелі гема,
# `brakeman/warning.rb#fingerprint`): відбиток є SHA256 над `@code.inspect`, тобто над
# AST САМОГО ВИРАЗУ. Тому будь-який рефактор — навіть перейменування змінної — зсуває
# його ЗА ПОБУДОВОЮ, і придушення протухає без жодної зміни ризику. Це властивість
# інструмента, не наша форма запису, тож «зробити важке непотрібним» тут неможливо.
# Ціна відмови, названа вголос (у відмови немає червоного, яке про неї нагадає):
# чотири коміти «re-pin fingerprint» — 07-05, 07-10, 08-23, 08-26 — і темп РОСТЕ,
# бо ростуть one-home рефактори. Кожен був червоним `main` на комміті, що не додав
# ЖОДНОГО ризику, а гейт, який падає не на тому, вчить гортати червоне.
#
# 🔑 `--ensure-no-obsolete-ignore-entries` несучий, і він тут ГОЛОВНИЙ: без нього
# протухле придушення виринає як «новий warning», тобто інструмент називає СИМПТОМ
# замість ПРЕДМЕТА. Прапорець прогнано на живому дереві перед вмиканням — EXIT 0,
# тобто периметр безкоштовний. ⚠️ Та сама форма мусить стояти в `ci.yml`: дві стійки
# однієї перевірки розходяться тихо, і паритет тут — не охайність, а умова того, щоб
# локальне зелене взагалі щось стверджувало про CI.
#
# NOT-RUN ⊥ FAILED — як у третього блоку: brakeman є bundle-залежністю, тож свіжий
# clone без `bundle install` друкує ГУЧНУ ноту й пропускає, а не робить push неможливим.
if printf '%s\n' "$_changed" | grep -qE '^(app|lib|config)/|^Gemfile'; then
  if ( cd "$root" && bundle exec brakeman --version ) >/dev/null 2>&1; then
    if ! ( cd "$root" && bin/brakeman --no-pager --ensure-no-obsolete-ignore-entries ); then
      echo
      echo "pre-push BLOCKED — brakeman reports findings (above)."
      echo "Fix:  bin/brakeman --no-pager --ensure-no-obsolete-ignore-entries"
      echo "  If the finding is an OBSOLETE ignore entry, the code moved and the"
      echo "  suppression did not: re-pin it with  bin/brakeman -I  (keep the note)."
      echo "Then re-push.  (Emergency bypass: git push --no-verify)"
      exit 1
    fi
  else
    echo "pre-push NOTE — app/lib/config changed but brakeman could not RUN."
    echo "  This is NOT a verdict: the check never ran. CI will run it (job \`scan_ruby\`)."
    echo "  Fix the toolchain:  bundle install"
  fi
fi

# [OPS.28] rubocop — пʼятий блок, і його купив ІНЦИДЕНТ цієї ж сесії (2026-08-28).
#
# 🔴 Ціну відмови не оцінено, а СПЛАЧЕНО: коміт `3aa62e3e` дав червоний `main` на джобі
# `lint` — три стилістичні порушення в новоствореному spec-файлі. Механіка промаху варта
# запису, бо вона не про забудькуватість: rubocop прогнали ТОЧКОВО, на тому файлі, який
# правили (`scripts/tracker_report.rb` — зелений), а файл, СТВОРЕНИЙ пізніше в тій самій
# сесії, у той прогін не входив. Повна сюїта була зелена й сказати про це не могла —
# rubocop до неї не належить. Тобто носієм вважався рефлекс «прогнати команду», а рефлекс
# носієм не є: він масштабується як O(n) шансів забути, тоді як хук є O(1) точкою, де
# забування перестає мати наслідки — рівно той самий довід, яким цей файл почався (DCO).
#
# ЦІНА, виміряна тут-таки, двома прогонами: 3.39 / 3.05 с → ~3.2 с на ПОВНЕ дерево
# (1019 файлів). Це ДЕШЕВШЕ за сусідній brakeman-блок (~3.5 с) і за i18n-трійку (~4 с),
# яка їде БЕЗУМОВНО, — тож за записаним критерієм цього файлу («межа є ЦІНОЮ») питання
# навіть не гранична: воно вже вирішене для дорожчих сусідів.
#
# ⚠️ Прогін ПОВНИЙ, а не по змінених файлах, і це свідомо: інкрементальна форма створила б
# другу стійку з іншим ПОПУЛЯЦІЙНИМ скоупом, ніж CI-джоба, а такі стійки розходяться
# тихо (§Guard-craft #43/#44 — паритет порівнює, ЩО біжить, і сліпий до того, над ЧИМ).
# За 3.2 с економія не варта нової осі розходження.
#
# NOT-RUN ⊥ FAILED — як у сусідів: rubocop є bundle-залежністю, тож свіжий clone без
# `bundle install` дістає ГУЧНУ ноту й проходить, а не стає непушабельним.
if printf '%s\n' "$_changed" | grep -qE '\.rb$|^\.rubocop|^Gemfile|^Rakefile'; then
  if ( cd "$root" && bundle exec rubocop --version ) >/dev/null 2>&1; then
    if ! ( cd "$root" && bin/rubocop ); then
      echo
      echo "pre-push BLOCKED — rubocop reports offenses (above)."
      echo "Fix:  bin/rubocop -a          # autocorrect what is safe"
      echo "Then re-push.  (Emergency bypass: git push --no-verify)"
      exit 1
    fi
    # 🔴 ДРУГИЙ виклик, і без нього блок був би НЕПОВНИМ проти CI — знайдено свіпом того
    # самого дня (2026-08-28), за кілька годин після того, як блок додали. `ci.yml` має ДВА
    # rubocop-кроки, бо `Lint/UselessAssignment` вимкнений у `.rubocop.yml` (`Enabled: false`
    # — живі хіти лише у `spec/`, де це фікстурні привʼязки) і вмикається ТОЧКОВО на
    # периметрі без `spec/`. Отже повний `bin/rubocop` вище його не бачить ЗА ПОБУДОВОЮ, і
    # хук мовчав би там, де CI червоніє — рівно той клас «дві стійки розходяться тихо»
    # (§Guard-craft #44: паритет порівнює, ЩО біжить, і сліпий до того, над ЧИМ).
    # ЦІНА виміряна окремо: 1.14 / 0.65 с на 452 файлах — дешевше за будь-який інший блок.
    if ! ( cd "$root" && bin/rubocop --only Lint/UselessAssignment app lib scripts config ); then
      echo
      echo "pre-push BLOCKED — dead assignment(s) on the app/lib/scripts/config perimeter."
      echo "This cop is OFF in .rubocop.yml on purpose and HARD in CI — a leftover"
      echo "assignment after a call-site removal is exactly what it catches."
      echo "Then re-push.  (Emergency bypass: git push --no-verify)"
      exit 1
    fi
  else
    echo "pre-push NOTE — Ruby changed but rubocop could not RUN."
    echo "  This is NOT a verdict: the check never ran. CI will run it (job \`lint\`)."
    echo "  Fix the toolchain:  bundle install"
  fi
fi

echo "pre-push: DCO + i18n parity OK."
