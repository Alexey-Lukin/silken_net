# ============================================================================
# ЕФЕКТИВНА ПОСТАВА ДЕПЛОЮ — і вона КОМІЧЕНА навмисно.
# ============================================================================
# Terraform підхоплює `*.auto.tfvars` САМ, без `-var-file`, і робить це однаково
# локально й у CI. Саме тому цей файл існує окремо від `terraform.tfvars`:
#
# 🔴 ПІДСТАВА (виміряно 2026-08-31, після першого живого apply). `terraform/*.tfvars`
# у `.gitignore`, тож у чекауті CI його НЕМАЄ, а `terraform_drift.yml` передає рівно три
# `TF_VAR` і не має `-var-file`. Отже КОЖЕН оверрайд, що жив лише в `terraform.tfvars`,
# читався б weekly-планом як ДРЕЙФ — і `Ops · TF Drift` став би вічно червоним. Це рівно
# та форма, яку [INF.22] уже відхилив поіменно: «гейт, який привчають гортати».
# ⊕ І окремо це вбивало duty-cycle-важелі: `db_activation_policy`/`compute_desired_status`
# заводились саме щоб зупинка була ЗАПИСАНИМ рішенням без дрейфу — а без спільного файлу
# та властивість трималась лише для ЛОКАЛЬНОГО плану.
#
# 🔑 Другий виграш, ширший за дрейф: доти фактична постава жила ЛИШЕ в нетрекованому файлі
# на одній машині. Тепер вона версіонована й ревʼюйована — тобто дім оголошеної постави
# перестав бути невидимим для всіх, крім власника.
#
# ⛔ СЕКРЕТИ СЮДИ НЕ ЙДУТЬ. `db_password` лишається в gitignored `terraform.tfvars`;
# `project_id` і `billing_account_id` приходять `TF_VAR`-ами з GitHub Secrets (env має
# НИЖЧИЙ пріоритет за tfvars-файли, тож локальні значення й далі виграють).
# ⚠️ Порядок завантаження: `terraform.tfvars` → `*.auto.tfvars` → `-var`. Пізніший ВИГРАЄ,
# тож дублювати тут те, що лежить у `terraform.tfvars`, означає створити другий дім.
# ============================================================================

region = "europe-west1"
# ⚠️ -d, бо -b і -c віддали «does not have enough resources» на e2-standard-2 (див. variables.tf)
zone = "europe-west1-d"

# ── Cloud SQL: pre-fleet розмір, не цільовий ────────────────────────────────
# ⚖️ founder 2026-08-31. ZONAL купує ціну, не втрачаючи збереження: PITR + 30 щоденних
# бекапів недоторкані. REGIONAL і 30-денне посекундне вікно лишаються ЦІЛЛЮ, gated на
# перший живий аплінк — дім присуду й подія повернення: docs/06_06 §2, 00_07 DR.1.
# ⛔ `edition = ENTERPRISE` НЕ тут — воно в database.tf, бо не тюнінг, а умова існування
# інстансу: ENTERPRISE_PLUS відхиляє всі `db-custom-*` тири.
db_tier               = "db-custom-1-3840"
db_availability_type  = "ZONAL"
db_disk_size_gb       = 20
db_max_connections    = "400"
db_read_replica_count = 0

# ── Duty-cycle: репетиція є ПОДІЄЮ, не станом ──────────────────────────────
# Зупинка між сесіями верифікації: виміряних $145/міс → ~$20. Ставиш NEVER/TERMINATED —
# це записане рішення, і CI бачить його разом із тобою (в цьому й був сенс файлу).
db_activation_policy   = "ALWAYS"
compute_desired_status = "RUNNING"

# ── Доступ і захист ─────────────────────────────────────────────────────────
enable_deletion_protection = true
iap_admin_members          = ["user:realvirtuozzz@gmail.com"]
# ⛔ Лишається порожнім: канонічний вхід — IAP-тунель, не CIDR (INF.20 (в)).
ssh_source_ranges = []

# ── FinOps (OPS.11) ─────────────────────────────────────────────────────────
# Стеля під pre-fleet-форму (виміряно $145/міс always-on 2026-09-01 — $100 НИЖЧЕ run-rate, алерт бюджету горітиме щомісяця: підняти або даунгрейдити тир — ⚖️ 00_07 OPS.37). `billing_account_id` — TF_VAR із секрета.
billing_budget_usd = 100
