# GCP Project
project_id = "your-gcp-project-id"
region     = "europe-west1"
zone       = "europe-west1-d"

# Database
db_password          = "CHANGE_ME_use_a_strong_password_16_chars_minimum"
db_tier              = "db-custom-2-7680"
db_availability_type = "REGIONAL"
db_disk_size_gb      = 50
db_max_connections   = "400"
db_read_replica_count = 0

# Protection
enable_deletion_protection = true

# SSH Access (INF.20 (в)) — canonical path = IAP tunnel + OS Login (no public :22):
#   gcloud compute ssh silken-net-ingress --tunnel-through-iap --zone europe-west1-d
# Members below get osAdminLogin (sudo for coap.env/systemctl) + IAP tunnel access.
iap_admin_members = ["user:CHANGE_ME@example.com"]

# Optional break-glass DIRECT ssh (bypasses IAP). Normally keep [] — the IAP
# firewall rule is unconditional; this one only opens :22 to the given CIDR.
ssh_source_ranges = []

# [INF.21] Anchor coap-daemon image — PIN an immutable tag for bring-up
# (mirror-ghcr pushes sha-<commit> per main push; vX.Y.Z on releases):
# coap_daemon_image = "ghcr.io/alexey-lukin/silken_net:sha-<commit>"

# [INF.22] Keyless CI: GitHub owner/repo allowed to impersonate the deploy SA via
# Workload Identity Federation. Default matches this repo; override only on rename.
# github_repository = "Alexey-Lukin/silken_net"

# [OPS.11] FinOps: billing budget (50/90/100% + forecasted e-mail thresholds).
# Find the id: `gcloud billing accounts list`. ⚠️ Mirror the SAME value into the
# GitHub secret GCP_BILLING_ACCOUNT_ID — its ONE consumer is the weekly
# terraform_drift.yml. Divergence costs NOISE (the drift `plan` reports the budget
# as a resource to remove), not the budget: [INF.22] removed the `terraform` job
# from both deploy workflows (⚖️ 2026-08-29 — apply stays founder-local), so a
# CI apply that could destroy it does not exist. This line said the opposite until
# 2026-08-31 — read at the exact moment you decide whether to fill the value in.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# billing_budget_usd = 100

# Redis — REMOVED from GCP (Memorystore has no public IP).
# Use Upstash (serverless Redis with TLS public endpoints) instead.
# Set REDIS_URL=rediss://default:password@endpoint.upstash.io:6379 in secrets.
# Free tier (256 MB, 500K commands/month) is sufficient through TRL 8.
# Create the instance in GCP europe-west1 — same region as Cloud SQL.
# See: docs/06_01_Deployment_Kamal_Terraform.md
