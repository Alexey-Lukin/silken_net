# =============================================================================
# Akash Deployment — Example Variables
# =============================================================================
# Copy to terraform.tfvars and fill in real values before deploying.
# Never commit terraform.tfvars with real secrets to version control.

# Akash Network
akash_key_name        = "silken-deploy"
akash_chain_id        = "akashnet-2"
akash_node            = "https://rpc.akashnet.net:443"
akash_auditor_address = "akash1365yvmc4s7awdyj3n2sav7xfx76adc6dnmlx63"
# [SEC.19] Provider region filter — data-in-use residency preference (ACTIVE:
# founder 2026-07-10 chose the soft EU preference from day one). Values mirror
# 04_01 data_region (eu-west, eu-central).
# ⚠️ SELF-REPORTED, not audited → a soft preference, NOT a residency guarantee; narrows
# the pool. Hard EU-PII residency = the GCP Ingress Anchor + Cloud SQL at-rest (06_02 §1.3).
# ⚠️ Fallback: if a render collects ZERO bids, comment this line out (region×signedBy
# can over-tighten the pool) and re-render — availability beats a soft preference.
akash_region = "eu-west"

# Application — [INF.21] pin an immutable tag for any real render (`sha-<commit>`
# from mirror-ghcr, or `vX.Y.Z` on releases): `:latest` moves under the lease on
# provider restart/migration and has no rollback target.
docker_image     = "ghcr.io/alexey-lukin/silken_net:sha-CHANGE_ME"
rails_master_key = "CHANGE_ME"

# ── FIRST Akash deploy = CANOPY render (founder 2026-07-04) ──────────────────
# The riskiest path (first-ever Akash deploy) must not debut on production.
# Uncomment BOTH lines for the canopy render; re-comment (defaults) for the
# production render only after the canopy smoke passes. See docs/06_01 §Чеклист.
# deployment_slot   = "canopy"
# postgres_database = "silken_net_canopy"

# Cloud SQL Auth Proxy — connects to Cloud SQL via Google Cloud API (HTTPS)
# No public IP on Cloud SQL required. No VPN/Tailscale needed.
# Component style (config/database.yml): host=127.0.0.1 + user=silken_net are non-secret
# literals in the SDL; only the password is injected here.
db_password                        = "CHANGE_ME_use_a_strong_password_16_chars_minimum"
cloud_sql_instance_connection_name = "your-project:europe-west1:silken-db"
gcp_sa_key_base64                  = "CHANGE_ME_base64_encoded_sa_key_json"

# Upstash Redis (serverless, TLS public endpoints)
# Replaces GCP Memorystore (which has no public IP and is unreachable from Akash).
# Free tier (10k commands/day) sufficient through TRL 8.
# Sign up: https://upstash.com/ → Create Redis database → Copy connection URL
redis_url = "rediss://default:CHANGE_ME@eu1-xyz.upstash.io:6379"

# Compute Resources (matches issue requirements: 4 vCPU, 8 GB RAM, 50 GB storage)
web_cpu_units           = 4
web_memory_size         = "8Gi"
web_storage_size        = "50Gi"
persistent_storage_size = "10Gi"

# Scaling & Pricing
web_replicas    = 1
web_concurrency = 4
max_price_uakt  = 10000

# Observability — Grafana Cloud (OBS.1)
# Sign up at https://grafana.com/products/cloud/ (free tier available)
# Create a Prometheus data source → copy the remote_write URL, instance ID, and API token.
grafana_remote_write_url      = "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"
grafana_remote_write_username = "123456"
grafana_remote_write_token    = "CHANGE_ME_grafana_cloud_api_token"

# Basic Auth for Rails /metrics endpoint (must match web service ENV vars)
prometheus_auth_user     = "prometheus"
prometheus_auth_password = "CHANGE_ME_metrics_password"

# =============================================================================
# 🛑 BOOT-CRITICAL — Rails refuses to boot in production without this
# =============================================================================
# HKDF root key for hardware provisioning (HardwareKeyService, OtaHmacKeyService).
# Generate: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
provisioning_master_key = "CHANGE_ME_64_hex_chars_from_SecureRandom_hex_32"

# ActiveRecord Encryption keys [SEC.22] — generate all three: bin/rails db:encryption:init
active_record_encryption_primary_key         = "CHANGE_ME_32_plus_chars"
active_record_encryption_deterministic_key   = "CHANGE_ME_32_plus_chars"
active_record_encryption_key_derivation_salt = "CHANGE_ME_32_plus_chars"

# =============================================================================
# Observability — Sentry
# =============================================================================
# From: https://<your-org>.sentry.io/settings/projects/silken-net/keys/
sentry_dsn = "https://CHANGE_ME@o000000.ingest.sentry.io/0000000"

# =============================================================================
# Web3 Oracle Keys (dual-key split, B-02 resolved)
# =============================================================================
# ⚠️ AKASH SECURITY NOTE: ENV vars are visible to the provider in plaintext.
# Rotate every 90 days. Prefer minimal on-chain roles (MINTER_ROLE only, never
# DEFAULT_ADMIN_ROLE) for Akash-deployment keys. See docs/06_02 (INF.*).
# Generate hex private key: openssl rand -hex 32 (then prepend 0x).
# Legacy shared oracle_private_key RETIRED [INF.22] — do not re-add (guard tripwire).
# Aux signers (ORACLE_ETHERISC/PURO/KLIMA_PRIVATE_KEY) are activation-gated:
# inject via Akash Console when their path goes live — never in tfvars/SDL.
# Dedicated Celo signer (ARCH.50) — required, no fallback.
oracle_celo_private_key      = "0xCHANGE_ME_dedicated_celo_cusd_signer"
oracle_minter_private_key    = "0xCHANGE_ME_holds_MINTER_ROLE_on_SCC_SFC"
oracle_slasher_private_key   = "0xCHANGE_ME_holds_SLASHER_ROLE_on_SCC_SFC"
ethereum_anchor_private_key  = "0xCHANGE_ME_separate_wallet_for_weekly_L1_anchor"

# =============================================================================
# RPC Endpoints (Web3::RpcConnectionPool)
# =============================================================================
alchemy_polygon_rpc_url  = "https://polygon-mainnet.g.alchemy.com/v2/CHANGE_ME"
alchemy_ethereum_rpc_url = "https://eth-mainnet.g.alchemy.com/v2/CHANGE_ME"
solana_rpc_url           = "https://api.mainnet-beta.solana.com"
celo_rpc_url             = "https://forno.celo.org"

# =============================================================================
# Solana Minting (Solana::MintingService)
# =============================================================================
# 64-byte private key, hex-encoded.
solana_wallet_keypair          = "CHANGE_ME_solana_keypair_hex"
solana_fee_payer_pubkey        = "CHANGE_ME_base58_fee_payer_pubkey"
solana_fee_payer_token_account = "CHANGE_ME_base58_usdc_ata_for_fee_payer"
# Mainnet USDC mint:
solana_usdc_mint_address = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

# =============================================================================
# Webhook HMACs: Chainlink callback (dispatch removed — ARCH.53) + Helium SOS (ARCH.34)
# =============================================================================
# Both: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
chainlink_hmac_secret = "CHANGE_ME_hmac_secret_for_callback_signature_verification"
# Also entered in Helium Console HTTP Integration (X-Helium-Signature).
helium_webhook_secret = "CHANGE_ME_hmac_secret_for_helium_sos_webhook"
