# macOS / IDE
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# Conda / virtual envs (multi-GB, machine-specific — NEVER commit)
env/
.env/
venv/
.venv/

# Datasets — large audio; tracked by a committed manifest (checksums), not git
data/raw/
data/processed/
*.wav
*.flac
*.ogg
*.npz

# Trained model artifacts — binary; the registry tracks provenance, not git
*.tflite
*.h5
*.keras
*.pkl

# Model registry: NOT blanket-ignored — commit the SMALL provenance so the generated
# firmware header's run/manifest hashes stay auditable and the header is re-emittable from
# the committed .tflite. Tracked: the 3 *.json (reproducibility/export_report/data_manifest)
# + model_int8.tflite + norm_stats.npz (re-included below). Ignored: model.keras (*.keras),
# the PTQ representative/parity .npz (*.npz), and the TF SavedModel temp dir (explicit).
models/registry/*/plain_sm/
!models/registry/*/model_int8.tflite
!models/registry/*/norm_stats.npz

# NB: the generated firmware headers (firmware/common/logmel_*.h) ARE committed —
# they are the golden source the C consumes — and live OUTSIDE this dir.
