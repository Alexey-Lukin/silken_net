<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SilkenNet CAD generator CLI. Our code: strict (warnings-as-errors,
       nullable, analyzers — inherited from ../../Directory.Build.props). PicoGK +
       LEAP types arrive transitively via the SilkenCad.Leap project reference. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SilkenCad</RootNamespace>
    <AssemblyName>silkencad</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SilkenCad.Leap/SilkenCad.Leap.csproj" />
  </ItemGroup>

</Project>
