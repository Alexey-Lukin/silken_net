<Project Sdk="Microsoft.NET.Sdk">

  <!-- Validation-as-code: pure-logic golden tests (CEM parse + gyroid SDF math + generator
       selection), fast and PicoGK-runtime-free. The rendered-metric gates (porosity, pore
       gradient, min-wall, manifold) run in the verify/sweep CLI. The .NET peer of
       `make -C firmware/test`. Package versions come from ../../Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SilkenCad/SilkenCad.csproj" />
  </ItemGroup>

</Project>
