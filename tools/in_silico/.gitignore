# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Serialized objects
*.pkl
*.pickle

# Conda envs should NEVER be committed (multi-GB, machine-specific binaries)
env/
.env/
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# MD simulation artifacts (large binary files — output, not source)
*.dcd
*.xtc
*.trr
*.h5
*.nc
*.log
*.chk
*.cpt
# …but a log that IS committed provenance is not a run cache: the Aggrescan3D run's own log
# carries the exact freesasa invocation, and its data folder is an INPUT home, not cache/runs.
!data/chem11_a3d/*.log

# Downloaded PDBs / one-off staging
downloads/

# MD run artefacts (trajectories, checkpoints) — large, regenerable
cache/runs/

# Keep small deterministic caches (e.g. GAFF parameter cache) under cache/

# Jupyter
*.nbconvert.ipynb
