# macOS
.DS_Store

# Conda envs should NEVER be committed (multi-GB, machine-specific binaries)
env/
.env/
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# MD simulation artifacts (large binary files — output, not source)
*.dcd
*.xtc
*.trr
*.h5
*.nc
*.log
*.chk
*.cpt

# Downloaded PDBs / one-off staging
downloads/

# MD run artefacts (trajectories, checkpoints) — large, regenerable
cache/runs/

# Keep small deterministic caches (e.g. GAFF parameter cache) under cache/

# Jupyter
*.nbconvert.ipynb
