# ============================================================
# Silken Net — Environment Variables Template
# ============================================================
# Скопіюйте цей файл:  cp .env.example .env
# НІКОЛИ не комітьте .env з реальними секретами!
#
# Мінімум для локальної розробки + симулятора:
#   REDIS_URL (вже заповнено), WEB3_STRICT_MODE=false
# Для повного Web3-стеку заповніть усі секції нижче.
#
# 🔄 Single source of truth для production deploy: цей файл МУСИТЬ бути
# у синхронізації з:
#   - .kamal/secrets-common                          (Kamal env injection)
#   - config/deploy.yml env.secret            (Kamal canonical list)
# Drift у будь-яку сторону → Puma boot crash або silent Web3 DeadSet.
#
# Деталі: docs/06_01_Deployment_Kamal_Terraform.md (Kamal/Terraform)
#         docs/06_04_Secrets_Checklist.md         (commit-ready checklist)
# ============================================================

# ─── Rails ───────────────────────────────────────────────────────────────────
RAILS_MASTER_KEY=          # ЛИШЕ локально (config/master.key, `credentials:edit`); з 2026-09-02 не є deploy-поверхнею (SEC.22 Phase-2)
# [SEC.22] У ПРОДІ обовʼязковий: образ не несе credentials.yml.enc (.dockerignore тримає
# його поза публічним GHCR), тож майстер-ключу нема чого розшифровувати → Rails падає
# «Missing secret_key_base». Локально можна лишити порожнім — dev читає credentials.
SECRET_KEY_BASE=           # = credentials.secret_key_base; інша величина розлогінює всіх
RAILS_ENV=development
# Версія деплою — передається в Sentry для tracking регресій між релізами
RELEASE_VERSION=
# Хост для Action Mailer links (production.rb default_url_options; default silkennet.com):
# APP_HOST=silkennet.app
# Puma concurrency (Kamal бере ці значення):
RAILS_MAX_THREADS=3        # DB connection pool size має збігатись з цим значенням
WEB_CONCURRENCY=2          # Кількість Puma worker processes (= vCPU app-хоста)
# Puma тюнинг (config/puma.rb defaults — переозначити лише за потребою):
# PUMA_MAX_IO_THREADS=16   # I/O thread pool (default: 16)
# PUMA_WORKER_TIMEOUT=60   # Sec до примусового рестарту worker'а (default: 60)
# Логування (production):
# RAILS_LOG_JSON=true      # JSON-formatted logs для GCP/Stackdriver (default: true; "false" → human)
# RAILS_LOG_LEVEL=warn     # debug|info|warn|error (default: warn у production)
# Skip dev-only Rails master.key strength sanity check (CI/тести):
# SILKENNET_SKIP_MASTER_KEY_STRENGTH_CHECK=1

# ─── Sidekiq / Solid Queue тюнинг ────────────────────────────────────────────
# Server-пулу змінної НЕМА і не буде [ARCH.59]: Sidekiq виводить капсульний пул із
# :concurrency (config/sidekiq.yml) і тримає окремий internal — дім 04_02 §11 DOC-R.10.
# Розмір Redis-пулу для Sidekiq client (default: RAILS_MAX_THREADS + 2 — капсул у
# клієнта немає, тож стелю задаємо ми):
# SIDEKIQ_CLIENT_POOL_SIZE=5
# Таймаут Redis-операцій у секундах (default: 5):
# SIDEKIQ_REDIS_TIMEOUT=5
# Solid Queue процеси (config/queue.yml — default: 1):
# JOB_CONCURRENCY=1

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Component style (config/database.yml — Rails-8 default; no DATABASE_URL parsing).
# Локально можна залишити порожнім — дефолти localhost / postgres / password.
# Перевизнач лише за потреби:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# Пул з'єднань (default: RAILS_MAX_THREADS + 2; Sidekiq job-роль ставить DB_POOL=17):
# DB_POOL=17
# Production / Canopy: POSTGRES_HOST = приватний IP Cloud SQL (Kamal у тій самій VPC);
# POSTGRES_PASSWORD через .kamal/secrets-common або CI secrets.

# ─── Redis ───────────────────────────────────────────────────────────────────
# ОДНА логічна база на всіх споживачів (Sidekiq · Kredis · Rack::Attack), розділені
# префіксом ключа, а не номером бази: Upstash дає рівно одну, і `SELECT 1` там —
# помилка [INF.22]. Локально навмисно так само, щоб dev не ховав цього класу.
REDIS_URL=redis://localhost:6379/0
# Обидва нижче — deploy-часовий важіль: задай, щоб вивести споживача на ОКРЕМИЙ
# інстанс (справжня ізоляція від memory pressure). Незадані — беруть REDIS_URL.
# KREDIS_REDIS_URL=redis://localhost:6379/0        # Kredis distributed locks (Web3 nonce)
# RACK_ATTACK_REDIS_URL=redis://localhost:6379/0   # Rate-limit counters
# CANOPY_REDIS_URL=redis://localhost:6379/0
# [INF.27] Canopy — TESTNET slot: `.kamal/secrets.canopy` remaps the four RPC names from
# these CANOPY_* twins (loud placeholder when unset, never the production value). Only a
# LOCAL `kamal deploy -d canopy` needs them in a shell; CI takes them from GitHub Secrets.
# CANOPY_ALCHEMY_POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
# CANOPY_ALCHEMY_ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# CANOPY_SOLANA_RPC_URL=https://api.devnet.solana.com
# CANOPY_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# ─── CoAP Daemon ─────────────────────────────────────────────────────────────
# UDP-порт для CoAP listener (Queen → Rails uplink). Default: 5683.
COAP_PORT=5683

# ─── Безпека / Provisioning ──────────────────────────────────────────────────
# HKDF-SHA256 майстер-ключ для деривації апаратних AES-ключів при provisioning.
# Zero-Trust: ключ НІКОЛИ не передається по мережі; пристрій деривує ключ незалежно.
# Генерація: openssl rand -hex 32  (або ruby -e "require 'securerandom'; puts SecureRandom.hex(32)")
#
# 🛑 BOOT-CRITICAL у production/canopy: config/initializers/master_key_strength_check.rb
# raises SecurityError у after_initialize при blank/weak значенні → Puma crash
# до accept loop. У dev/test guard вимкнено (spec/rails_helper.rb pin'ить fixture).
# Override: SILKENNET_SKIP_MASTER_KEY_STRENGTH_CHECK=1 (тільки rescue boot).
PROVISIONING_MASTER_KEY=

# ─── Безпека / Rails Web (config/environments/production.rb, config/initializers/) ──
# DISABLE_SSL — вимикає force_ssl/assume_ssl у production.rb. Залишати пустим або
# не встановлювати для нормальної роботи (SSL ввімкнено за замовчуванням).
# Лише для non-TLS canary-деплоїв за Cloudflare без TLS termination на origin.
# DISABLE_SSL=true

# RAILS_ALLOWED_HOSTS — allowlist хостів для захисту від DNS-rebinding атак.
# Comma-separated, підтримує leading "." для subdomain wildcard.
# Залишити пустим для локальної розробки (допустимо).
# ⚠️  Production: встановити, інакше Rails логує попередження [SECURITY] при старті.
# ⚠️  Web-хост перелічувати ЯВНО — wildcard ".silkennet.com" НЕ покриває інший TLD
#     (silkennet.app) → 403 block-all. Канон-пара + актуальне значення — 06_04 §2.1.
# Приклад: RAILS_ALLOWED_HOSTS=silkennet.app,api.silkennet.com
# RAILS_ALLOWED_HOSTS=
#
# ACTIVE_STORAGE_SERVICE — імʼя сервісу з config/storage.yml (default production_mirror).
# Canopy ставить `local` (Disk у контейнері) — staging без storage-кредів (06_04 §2.1).
# ACTIVE_STORAGE_SERVICE=

# ALLOW_ALL_HOSTS — заглушує попередження [SECURITY] про відсутній RAILS_ALLOWED_HOSTS.
# Корисно якщо хости динамічні (bare-IP scrape).
# ALLOW_ALL_HOSTS=true

# CSP_ENFORCE — вмикає примусовий режим Content Security Policy (замість report-only).
# Рекомендовано після спостереження violation-репортів протягом 1-2 тижнів.
# CSP_ENFORCE=true

# ─── Web3 — Режим роботи ─────────────────────────────────────────────────────
# false → стаби активні (development / тестування без реальних ключів).
# true  → всі Web3-стаби вимикаються; сервіси піднімають виключення
#          при відсутності ENV (production-режим).
WEB3_STRICT_MODE=false

# ─── Web3 — Oracle Gаманці (Private Keys) ────────────────────────────────────
# ⚠️  НІКОЛИ не комітити реальні ключі!
# Легасі спільний ORACLE_PRIVATE_KEY RETIRED [INF.22] — жоден код його не читає,
# boot-guard відмовляє значенню під цим ім'ям. Кожен підписант = свій ключ (E.2).
#
# Ключ MINTER_ROLE (мінтинг SCC/SFC):
ORACLE_MINTER_PRIVATE_KEY=0x...
# Окремий ключ для SLASHER_ROLE (спалювання SCC при деградації лісу):
ORACLE_SLASHER_PRIVATE_KEY=0x...
# Ключ для тижневого anchoring на Ethereum L1 (StateRootAnchor contract):
ETHEREUM_ANCHOR_PRIVATE_KEY=0x...
# Activation-gated aux-підписанти (лише коли шлях живий; НЕ ставити placeholder):
# ORACLE_ETHERISC_PRIVATE_KEY=0x...   (insurance claims)
# ORACLE_PURO_PRIVATE_KEY=0x...       (Puro.earth passport anchor)
# ORACLE_KLIMA_PRIVATE_KEY=0x...      (Klima retirement — воркер dead-gated)

# ─── Web3 — Polygon (Primary EVM) ────────────────────────────────────────────
# Alchemy Polygon RPC (Mainnet або Amoy для testnet):
ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Резервні RPC Polygon — keyless публічні ендпоінти ІНШИХ операторів (Web3::ResilientClient
# fallback cascade; ARCH.114 ⚖️ 2026-09-02). Не секрети: у деплої їдуть env.clear-літералами;
# чейн судить Security::Web3NetworkGuard::RPC_FALLBACK_URL_ENVS. Виміряно з app-VM 2026-09-02.
POLYGON_RPC_URL_FALLBACK_1=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_URL_FALLBACK_2=https://polygon.drpc.org

# Адреси смарт-контрактів (Polygon Mainnet / Amoy):
CARBON_COIN_CONTRACT_ADDRESS=0x...          # SCC ERC-20 (утилітарний токен)
FOREST_COIN_CONTRACT_ADDRESS=0x...          # SFC ERC-20 (governance DAO)
DAO_TREASURY_ADDRESS=0x...                  # DAO Treasury (Dynamic Tax 2%)
PURO_EARTH_REGISTRY_CONTRACT_ADDRESS=0x...  # D-MRV Registry (Puro.earth CORC)
ETHERISC_DIP_CONTRACT_ADDRESS=0x...         # Параметричне страхування (EWS)
KLIMA_RETIREMENT_CONTRACT=0x...             # KlimaDAO carbon retirement
TOUCAN_BRIDGE_CONTRACT_ADDRESS=0x...        # Toucan Protocol bridge

# ─── Web3 — Ethereum L1 (State Anchoring) ────────────────────────────────────
# Alchemy Ethereum Mainnet RPC (щотижнева фіналізація SHA-256 state root):
ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# StateRootAnchor contract address (Ethereum Mainnet):
ETHEREUM_ANCHOR_CONTRACT=0x...
# Gas management (defaults прописані в StateAnchorService):
ETHEREUM_MAX_FEE_GWEI=100    # Default: 100 Gwei cap
ETHEREUM_PRIORITY_FEE_GWEI=2 # Default: 2 Gwei (validator tip)

# [ARCH.62] EIP-1559 fee для Polygon/Celo — БЕЗ дефолту в коді СВІДОМО.
# Не задано → на дроті лишаються gem-дефолти `eth 0.5.17` (42.69 / 1.01 Gwei),
# позначені в самому гемі як `# Do not use.`, і `Web3::FeePolicy` пише про це
# гучний WARN. Обидва числа мережі задаються РАЗОМ: cap без priority лишає
# tip 1.01 Gwei, тобто «полагоджено» на вигляд і невключабельно насправді.
#
# ⚠️ НАПРЯМОК РИЗИКУ ІНВЕРСНИЙ: maxFee — не стеля витрат, а підлога готовності
# майнитись (за EIP-1559 платиться baseFee+priority, maxFee лише обмежує).
# Занизьке число не економить — воно лишає tx у вічному `:sent` → rollback →
# manual_review. Величина = ⚖️ founder-присуд (00_07 ARCH.62), і перед
# фіксацією її треба звірити ЖИВИМ прогоном: орієнтири нижче взято з вебу,
# а не з ноди, тож вони показують ПОРЯДОК, не значення.
#   · Polygon PoS: мінімальна priority fee ≈25 Gwei, середня у 2026 йшла 82→224
#   · Celo: власний fee-механізм, порядок звірити окремо
# POLYGON_MAX_FEE_GWEI=
# POLYGON_PRIORITY_FEE_GWEI=
# CELO_MAX_FEE_GWEI=
# CELO_PRIORITY_FEE_GWEI=
ETHEREUM_GAS_LIMIT=100000    # Default: 100_000 (~45k gas для storeStateRoot)

# ─── Web3 — Chainlink (Oracle DON) ───────────────────────────────────────────
# Functions Router address (Polygon Amoy для testnet):
CHAINLINK_FUNCTIONS_ROUTER=0x...
# ID підписки Chainlink Functions:
CHAINLINK_SUBSCRIPTION_ID=
# HMAC-SHA256 секрет для верифікації X-Chainlink-Signature у oracle callbacks:
CHAINLINK_HMAC_SECRET=
# DON ID (bytes32, наприклад fun-polygon-mainnet-1):
CHAINLINK_DON_ID=
# Chainlink Functions data version (default: 1):
CHAINLINK_DATA_VERSION=1
# Callback gas limit для Chainlink Functions response:
CHAINLINK_CALLBACK_GAS_LIMIT=300000
# Версія Router-контракту (default: v1; реєстр у Web3::ChainlinkRouterVersion):
# CHAINLINK_ROUTER_VERSION=v1
# Bytecode-sanity check (default: true; вимкнути лише для staging/dev RPC, який не повертає bytecode):
# CHAINLINK_ROUTER_BYTECODE_CHECK=true

# ─── Web3 — Solana (Micro-Rewards) ───────────────────────────────────────────
# Solana RPC primary — keyed вендор (Helius / QuickNode) на mainnet, `api.devnet.solana.com` на canopy:
SOLANA_RPC_URL=https://<helius-or-quicknode>.example/<key>
# [INF.22] Fallback RPC cascade — Solana::MintingService (execute_rpc_call) пробує їх
# по черзі при недоступності primary (timeout / 429 / conn). Незалежний провайдер = інший
# шлях доступу. ⚠️ Сервіс робить `urls.uniq`: однаковий primary й FALLBACK_1 дають ОДИН URL,
# тобто каскад оголошений і відсутній. PublicNode/dRPC для Solana віддають 403 (виміряно
# 2026-09-02) — другий птах тут лише офіційний ендпоінт. Порожні → single-RPC (skip-clean).
SOLANA_RPC_URL_FALLBACK_1=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_FALLBACK_2=
# Hex-encoded 32-байтний Ed25519 seed (64 hex-символи), НЕ JSON-масив `solana-keygen`
# (так цей файл брехав до 2026-09-02; сервіс читає `Ed25519Crypto::SigningService.sign(seed_hex, …)`).
# Генерація без Solana CLI: bin/rails runner "k = Ed25519Crypto::SigningService.generate_keypair; puts k[:seed_hex]"
SOLANA_WALLET_KEYPAIR=
# Public key fee payer (base58):
SOLANA_FEE_PAYER_PUBKEY=
# Associated Token Account fee payer для USDC (base58):
SOLANA_FEE_PAYER_TOKEN_ACCOUNT=
# (SOLANA_MINT_AUTHORITY_PUBKEY видалено — код не читає цю ENV; підпис іде SOLANA_WALLET_KEYPAIR)
# USDC SPL Token Mint address на Solana Mainnet:
SOLANA_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Опційний destination ATA для всіх Solana mint/transfer операцій (override per-wallet target):
# SOLANA_DEST_TOKEN_ACCOUNT=

# ─── Web3 — Celo (Community ReFi Rewards) ────────────────────────────────────
# Celo RPC (публічний або через Alchemy):
# ⚠️ ОБОВʼЯЗКОВА з 2026-08-31: hardcoded-фолбек знято (⚖️ — на money-шляху «працює без
# конфіга» є небезпекою, не зручністю), тож порожнє значення дає KeyError на КОЖНОМУ
# Celo-виклику, а boot-гард E.49 ловить це ще на деплої, якщо присутній ORACLE_CELO_PRIVATE_KEY.
CELO_RPC_URL=https://forno.celo.org
# [E.49] Fallback RPC cascade — використовуються Web3::ResilientClient'ом
# (circuit breaker, auto-failover при HTTP 429 / Net::ReadTimeout).
# Заведено (⚖️ founder 2026-09-02): keyless публічні ендпоінти ІНШИХ операторів —
# PublicNode + dRPC (виміряні живими з app-VM); акаунтний вендор — лише якщо вкусять rate-limit-и.
# ⛔ Keyed-URL під іменем *_FALLBACK_N НЕ комітити: deploy_secret_scan бачить лише суфікс _RPC_URL.
CELO_RPC_URL_FALLBACK_1=https://celo-rpc.publicnode.com
CELO_RPC_URL_FALLBACK_2=https://celo.drpc.org
# cUSD contract address на Celo Mainnet:
CELO_CUSD_CONTRACT_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a

# ─── Web3 — peaq (Machine DID) ───────────────────────────────────────────────
# Усі секрети нижче: код читає ENV-primary (SEC.22), Rails credentials = fallback.
# peaq network node URL для DID реєстрації Солдатів:
PEAQ_NODE_URL=https://wss.peaq.network
# Ed25519 ключ підпису DID транзакцій (обов'язковий для register_on_peaq):
PEAQ_SIGNING_KEY=
# ⚠️ Fallback: credentials.peaq_node_url / credentials.peaq_signing_key

# ─── Web3 — IoTeX W3bstream (ZK-Proof Verification) ─────────────────────────
# W3bstream endpoint + Bearer ключ (обидва читаються з ENV, SEC.22):
# ⛔ Хост `w3bstream-api.iotex.io` не має DNS-запису (виміряно 2026-09-02, ARCH.118) — прикладу
# значення тут свідомо немає: нога ACTIVATION-GATED (`Iotex::W3bstreamVerificationService.configured?`),
# порожні обидва = жодного enqueue/ре-арму, `verified_by_iotex` чесно false.
IOTEX_W3BSTREAM_URL=
IOTEX_API_KEY=
# ⚠️ Fallback: credentials.iotex_w3bstream_url / credentials.iotex_api_key

# ─── Web3 — Filecoin / IPFS (Pinata) ─────────────────────────────────────────
# Pinata JWT для pinning телеметрії в IPFS/Filecoin (ENV-primary, SEC.22):
FILECOIN_API_KEY=
# Filecoin gateway та pinning URL (defaults нижче):
FILECOIN_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
FILECOIN_PINNING_API_URL=https://api.pinata.cloud/pinning/pinJSONToIPFS
# ⚠️ Fallback: credentials.filecoin_api_key

# ─── Web3 — Polygon Hadron (KYC / ERC-3643 Compliance) ──────────────────────
# Hadron Identity Platform API:
HADRON_API_URL=https://api.hadron.polygon.technology
# API ключ Hadron (ENV-primary, SEC.22; fallback credentials.hadron_api_key):
HADRON_API_KEY=

# ─── Web3 — dClimate (Satellite EWS Verification) ────────────────────────────
# dClimate FIRMS API base URL для верифікації пожеж через NASA VIIRS:
DCLIMATE_BASE_URL=https://api.dclimate.net
# NASA FIRMS dataset (default достатньо):
DCLIMATE_FIRMS_DATASET=firms_nrt_global-area_v2
# dClimate Bearer ключ (ENV-primary, SEC.22; fallback credentials.dclimate.api_key):
DCLIMATE_API_KEY=

# ─── Puro.earth (D-MRV Biochar CORC Registry) ────────────────────────────────
# Puro.earth REST API base URL для D-MRV submissions:
PURO_EARTH_API_URL=https://registry.api.puro.earth/registry/api
# API ключ (ENV-primary, SEC.22; fallback credentials.puro_earth.api_key):
PURO_EARTH_API_KEY=

# ─── Web3 — Streamr (P2P Real-time Telemetry) ────────────────────────────────
# Streamr P2P broadcast для real-time трансляції телеметрії:
STREAMR_STREAM_ID=silken_net/forest_telemetry
# Streamr API ключ (ENV-primary, SEC.22; fallback credentials.streamr_api_key):
STREAMR_API_KEY=

# ─── Web3 — The Graph (Subgraph Indexing) ────────────────────────────────────
# The Graph subgraph URL для GraphQL запитів SCC подій (ENV-primary, SEC.22):
THE_GRAPH_API_URL=https://api.thegraph.com/subgraphs/name/silken-net/carbon
# ⚠️ Fallback: credentials.the_graph_api_url

# ─── Моніторинг — Prometheus ─────────────────────────────────────────────────
PROMETHEUS_AUTH_USER=prometheus
PROMETHEUS_AUTH_PASSWORD=
# Дозволені IP для /metrics endpoint (через кому), наприклад: 10.0.0.5,127.0.0.1
PROMETHEUS_ALLOWED_IPS=127.0.0.1

# ─── Моніторинг — Sentry ─────────────────────────────────────────────────────
# Отримайте DSN у своєму Sentry-проєкті (Settings → Client Keys).
# Без цього Sentry інертний; помилки в production не відстежуються
# (silent failure). Обов'язково в Kamal env.secret.
SENTRY_DSN=
# Частка транзакцій для performance tracing (default: 0.001 = 0.1%):
SENTRY_TRACES_SAMPLE_RATE=0.001
# Кількість Sentry worker-потоків для асинхронного відправлення подій (default: 2):
SENTRY_WORKER_THREADS=2

# ─── Governance / Protocol Parameters ────────────────────────────────────────
# Адреса ProtocolParameters.sol (Polygon). Якщо не задано — Governance::ParameterSyncWorker
# логує "skipping sync" і не порушує pipeline.
# PROTOCOL_PARAMETERS_CONTRACT_ADDRESS=0x...

# ─── Telemetry / DCI Numeric Tolerance Band [FW.31] ──────────────────────────
# Feature-flag для числового порівняння device_z vs server_z (понад категоричний enum).
# Активний branch тільки коли LoRa packet revision почне нести raw Z (post-FW.2),
# або після лабораторного вимірювання реального ARM↔x86 IEEE-754 drift на target HW.
# GAIA_DCI_NUMERIC_TOLERANCE=false   # true → вмикає numeric branch у TelemetryUnpackerService
# GAIA_DCI_NUMERIC_EPSILON=0.001     # |device_z - server_z| ≤ ε ⇒ OK (default: 0.001; malformed → fallback)
# Шифрування телеметрії CCM (TelemetryUnpackerService; default off — gated FW.2):
# TELEMETRY_CCM_ENABLED=false
# InsightGenerator stress-index пороги/ваги (nil-safe; defaults у коді):
# STRESS_SAP_LOW_THRESHOLD=  STRESS_SAP_WEIGHT=  STRESS_ACOUSTIC_THRESHOLD=  STRESS_ACOUSTIC_WEIGHT=
# VPD_CONFOUNDER_LOW_KPA=  VPD_CONFOUNDER_MAX_DISCOUNT=

# ─── Maintenance / Patrol Economics ──────────────────────────────────────────
# Погодинна ставка patrol-обходу, використовується MaintenanceRecord для оцінки labor cost
# (default: 50.0 USD/год):
# PATROL_LABOR_RATE=50

# ─── Карта: Leaflet + CARTO basemaps ────────────────────────────────────────
# [UI.19] CARTO basemaps вимагають безкоштовний API-ключ (форма carto.com/basemaps/apikey/,
# 5 M тайлів/міс; обмежити за referrer). Публічний за природою — їде в URL тайла в браузері →
# env.clear у config/deploy.yml, НЕ секрет. Порожньо = keyless URL (grace-шлях), карта жива.
# CARTO_API_KEY=

# ─── Active Storage (Rails) ──────────────────────────────────────────────────
# Облікові дані — ENV-primary (config/storage.yml: ENV[..].presence || credentials).
# 🔴 [SEC.22] Ці три НЕ входять у «вісім сервісів» §5.7 і до 2026-08-31 не мали
# рядка НІДЕ — тож Phase-2 (drop RAILS_MASTER_KEY), виконаний дослівно, лишив би
# Active Storage без креденшелів і тихо вбив фотодокази MaintenanceRecord.
# GCS_CREDENTIALS_JSON несе keyfile ЦІЛКОМ → env.secret, не env.clear.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GCS_CREDENTIALS_JSON=
# Нижче — не секрети, лише конфіг. Дефолт бакета = silken-net-<DEPLOYMENT_SLOT>,
# а НЕ Rails.env ([INF.27]: обидва слоти біжать RAILS_ENV=production, тож спільне
# імʼя дало б canopy право purge-ити продовий обʼєкт при власній таблиці blobs).
# AWS_REGION=eu-central-1
# AWS_BUCKET=silken-net-production
# GCS_PROJECT=silken-net
# GCS_BUCKET=silken-net-production

# ─── Deploy-only (Kamal / GCP / Foundry) ─────────────────────────────────────
# Ці змінні потрібні лише для деплою — не для локальної розробки.
# Детальніше: docs/06_01_Deployment_Kamal_Terraform.md
#
# POLYGONSCAN_API_KEY=    # Верифікація контрактів через Foundry (forge --verify)
# GCP_ARTIFACT_REGISTRY_KEY=  # base64 JSON ключ GCP Service Account
# DATABASE_URL=           # Production DB (Cloud SQL)
# CANOPY_DATABASE_URL=    # Staging DB
