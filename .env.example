# ============================================================
# Silken Net / Gaia 2.0 — Environment Variables Template
# ============================================================
# Скопіюйте цей файл:  cp .env.example .env
# НІКОЛИ не комітьте .env з реальними секретами!
#
# Мінімум для локальної розробки + симулятора:
#   REDIS_URL (вже заповнено), WEB3_STRICT_MODE=false
# Для повного Web3-стеку заповніть усі секції нижче.
# Деталі: docs/06_01_Deployment_Kamal_Terraform.md
# ============================================================

# ─── Rails ───────────────────────────────────────────────────────────────────
RAILS_MASTER_KEY=          # config/master.key (генерується автоматично)
RAILS_ENV=development
# Версія деплою — передається в Sentry для tracking регресій між релізами
RELEASE_VERSION=
# Puma concurrency (Kamal/Akash SDL використовують ці значення):
RAILS_MAX_THREADS=3        # DB connection pool size має збігатись з цим значенням
WEB_CONCURRENCY=2          # Кількість Puma worker processes (Akash SDL: 4)

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Для локальної розробки можна залишити порожнім — використовується
# конфігурація з config/database.yml (socket або localhost).
MY_APP_DATABASE_URL=       # postgres://silken_net:<password>@localhost:5432/silken_net_development
SILKEN_NET_DATABASE_PASSWORD=
# Production / Canopy (заповнюються через .kamal/secrets або CI secrets):
# DATABASE_URL=postgres://silken_net:<password>@<cloud-sql-private-ip>:5432/silken_net_production
# CANOPY_DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0    # Sidekiq черги
KREDIS_REDIS_URL=redis://localhost:6379/1  # Kredis distributed locks (Web3 nonce)
# RACK_ATTACK_REDIS_URL=redis://localhost:6379/2  # Rate-limit counters (auto-derived from REDIS_URL/2 if omitted)
# CANOPY_REDIS_URL=redis://localhost:6379/0

# ─── CoAP Daemon ─────────────────────────────────────────────────────────────
# UDP-порт для CoAP listener (Queen → Rails uplink). Default: 5683.
COAP_PORT=5683

# ─── Безпека / Provisioning ──────────────────────────────────────────────────
# HKDF-SHA256 майстер-ключ для деривації апаратних AES-ключів при provisioning.
# Zero-Trust: ключ НІКОЛИ не передається по мережі; пристрій деривує ключ незалежно.
# Генерація: openssl rand -hex 32
PROVISIONING_MASTER_KEY=

# ─── Безпека / Rails Web (config/environments/production.rb, config/initializers/) ──
# DISABLE_SSL — вимикає force_ssl/assume_ssl у production.rb. Залишати пустим або
# не встановлювати для нормальної роботи (SSL ввімкнено за замовчуванням).
# Лише для non-TLS canary-деплоїв за Cloudflare/Akash ingress без TLS termination.
# DISABLE_SSL=true

# RAILS_ALLOWED_HOSTS — allowlist хостів для захисту від DNS-rebinding атак.
# Comma-separated, підтримує leading "." для subdomain wildcard.
# Залишити пустим для локальної розробки (допустимо).
# ⚠️  Production: встановити, інакше Rails логує попередження [SECURITY] при старті.
# Приклад: RAILS_ALLOWED_HOSTS=api.silkennet.com,.silkennet.com
# RAILS_ALLOWED_HOSTS=

# ALLOW_ALL_HOSTS — заглушує попередження [SECURITY] про відсутній RAILS_ALLOWED_HOSTS.
# Корисно якщо хости динамічні (Akash deployment, bare-IP scrape).
# ALLOW_ALL_HOSTS=true

# CSP_ENFORCE — вмикає примусовий режим Content Security Policy (замість report-only).
# Рекомендовано після спостереження violation-репортів протягом 1-2 тижнів.
# CSP_ENFORCE=true

# ─── Web3 — Режим роботи ─────────────────────────────────────────────────────
# false → стаби активні (development / тестування без реальних ключів).
# true  → всі Web3-стаби вимикаються; сервіси піднімають виключення
#          при відсутності ENV (production-режим).
WEB3_STRICT_MODE=false

# ─── Web3 — Oracle Gаманці (Private Keys) ────────────────────────────────────
# ⚠️  НІКОЛИ не комітити реальні ключі! Зберігати у Rails credentials або Vault.
#
# Головний oracle-ключ: Chainlink dispatch, мінтинг SCC/SFC, PuroEarth (MINTER_ROLE)
ORACLE_PRIVATE_KEY=0x...
# Окремий ключ для MINTER_ROLE (якщо відокремлений від ORACLE_PRIVATE_KEY):
ORACLE_MINTER_PRIVATE_KEY=0x...
# Окремий ключ для SLASHER_ROLE (спалювання SCC при деградації лісу):
ORACLE_SLASHER_PRIVATE_KEY=0x...
# Ключ для тижневого anchoring на Ethereum L1 (StateRootAnchor contract):
ETHEREUM_ANCHOR_PRIVATE_KEY=0x...

# ─── Web3 — Polygon (Primary EVM) ────────────────────────────────────────────
# Alchemy Polygon RPC (Mainnet або Amoy для testnet):
ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Infura — резервний RPC (Web3::ResilientClient fallback cascade):
INFURA_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
# Polygon RPC для Uniswap V3 Quoter (PriceOracleService):
POLYGON_RPC_URL=https://polygon-rpc.com

# Адреси смарт-контрактів (Polygon Mainnet / Amoy):
CARBON_COIN_CONTRACT_ADDRESS=0x...          # SCC ERC-20 (утилітарний токен)
FOREST_COIN_CONTRACT_ADDRESS=0x...          # SFC ERC-20 (governance DAO)
DAO_TREASURY_ADDRESS=0x...                  # DAO Treasury (Dynamic Tax 2%)
PURO_EARTH_REGISTRY_CONTRACT_ADDRESS=0x...  # D-MRV Registry (Puro.earth CORC)
ETHERISC_DIP_CONTRACT_ADDRESS=0x...         # Параметричне страхування (EWS)
KLIMA_RETIREMENT_CONTRACT=0x...             # KlimaDAO carbon retirement
TOUCAN_BRIDGE_CONTRACT_ADDRESS=0x...        # Toucan Protocol bridge

# ─── Web3 — Ethereum L1 (State Anchoring) ────────────────────────────────────
# Alchemy Ethereum Mainnet RPC (щотижнева фіналізація SHA-256 state root):
ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# StateRootAnchor contract address (Ethereum Mainnet):
ETHEREUM_ANCHOR_CONTRACT=0x...
# Gas management (defaults прописані в StateAnchorService):
ETHEREUM_MAX_FEE_GWEI=100    # Default: 100 Gwei cap
ETHEREUM_PRIORITY_FEE_GWEI=2 # Default: 2 Gwei (validator tip)
ETHEREUM_GAS_LIMIT=100000    # Default: 100_000 (~45k gas для storeStateRoot)

# ─── Web3 — Chainlink (Oracle DON) ───────────────────────────────────────────
# Functions Router address (Polygon Amoy для testnet):
CHAINLINK_FUNCTIONS_ROUTER=0x...
# ID підписки Chainlink Functions:
CHAINLINK_SUBSCRIPTION_ID=
# HMAC-SHA256 секрет для верифікації X-Chainlink-Signature у oracle callbacks:
CHAINLINK_HMAC_SECRET=
# DON ID (bytes32, наприклад fun-polygon-mainnet-1):
CHAINLINK_DON_ID=
# Chainlink Functions data version (default: 1):
CHAINLINK_DATA_VERSION=1
# Callback gas limit для Chainlink Functions response:
CHAINLINK_CALLBACK_GAS_LIMIT=300000

# ─── Web3 — Solana (Micro-Rewards) ───────────────────────────────────────────
# Solana RPC (Mainnet Beta або Devnet для тестування):
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Ed25519 keypair у форматі JSON-масиву байтів (обов'язковий):
# Генерація: solana-keygen new --outfile /tmp/sol-keypair.json && cat /tmp/sol-keypair.json
SOLANA_WALLET_KEYPAIR=[]
# Public key fee payer (base58):
SOLANA_FEE_PAYER_PUBKEY=
# Associated Token Account fee payer для USDC (base58):
SOLANA_FEE_PAYER_TOKEN_ACCOUNT=
# Mint authority public key (base58, для підпису SPL Token операцій):
SOLANA_MINT_AUTHORITY_PUBKEY=
# USDC SPL Token Mint address на Solana Mainnet:
SOLANA_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ─── Web3 — Celo (Community ReFi Rewards) ────────────────────────────────────
# Celo RPC (публічний або через Alchemy):
CELO_RPC_URL=https://forno.celo.org
# cUSD contract address на Celo Mainnet:
CELO_CUSD_CONTRACT_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a

# ─── Web3 — peaq (Machine DID) ───────────────────────────────────────────────
# peaq network node URL для DID реєстрації Солдатів:
PEAQ_NODE_URL=https://wss.peaq.network
# ⚠️ Також зберігається у Rails credentials:
#   credentials.peaq_node_url    — URL peaq-ноди
#   credentials.peaq_signing_key — Ed25519 ключ підпису DID транзакцій

# ─── Web3 — IoTeX W3bstream (ZK-Proof Verification) ─────────────────────────
# W3bstream API URL (IoTeX) — також в credentials як credentials.iotex_w3bstream_url:
W3BSTREAM_API_URL=https://w3bstream-api.iotex.io
# Project ID у W3bstream (налаштовується в IoTeX console):
W3BSTREAM_PROJECT_ID=silken_net_dmrv
# ⚠️ Секрети IoTeX зберігаються у Rails credentials:
#   credentials.iotex_w3bstream_url — URL (альтернативно до W3BSTREAM_API_URL)
#   credentials.iotex_api_key       — Bearer API ключ (обов'язковий)

# ─── Web3 — Filecoin / IPFS (Pinata) ─────────────────────────────────────────
# Pinata API credentials для pinning телеметрії в IPFS/Filecoin:
PINATA_API_KEY=
PINATA_SECRET_KEY=
# Filecoin gateway та pinning URL (defaults нижче):
FILECOIN_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
FILECOIN_PINNING_API_URL=https://api.pinata.cloud/pinning/pinJSONToIPFS
# ⚠️ Альтернативно: filecoin_api_key можна зберігати у Rails credentials

# ─── Web3 — Polygon Hadron (KYC / ERC-3643 Compliance) ──────────────────────
# Hadron Identity Platform API:
HADRON_API_URL=https://api.hadron.polygon.technology
# ⚠️ API ключ Hadron зберігається у Rails credentials: credentials.hadron.api_key
# (або ENV для dev: HADRON_API_KEY=...)
HADRON_API_KEY=

# ─── Web3 — dClimate (Satellite EWS Verification) ────────────────────────────
# dClimate FIRMS API base URL для верифікації пожеж через NASA VIIRS:
DCLIMATE_BASE_URL=https://api.dclimate.net
# NASA FIRMS dataset (default достатньо):
DCLIMATE_FIRMS_DATASET=firms_nrt_global-area_v2
# ⚠️ dClimate Bearer API ключ зберігається у Rails credentials: credentials.dclimate.api_key

# ─── Puro.earth (D-MRV Biochar CORC Registry) ────────────────────────────────
# Puro.earth REST API base URL для D-MRV submissions:
PURO_EARTH_API_URL=https://api.puro.earth
# Fallback API ключ (preferred: Rails credentials: credentials.puro_earth.api_key):
PURO_EARTH_API_KEY=

# ─── Web3 — Streamr (P2P Real-time Telemetry) ────────────────────────────────
# Streamr P2P broadcast для real-time трансляції телеметрії:
STREAMR_API_URL=https://streamr.network/api/v2
STREAMR_STREAM_ID=silken_net/forest_telemetry
# ⚠️ Streamr API ключ зберігається у Rails credentials: credentials.streamr.api_key

# ─── Web3 — The Graph (Subgraph Indexing) ────────────────────────────────────
# The Graph subgraph URL для GraphQL запитів SCC подій (read-only):
THE_GRAPH_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/silken-net/carbon
# ⚠️ The Graph API URL також можна зберегти у Rails credentials: credentials.the_graph.api_url

# ─── Моніторинг — Prometheus ─────────────────────────────────────────────────
PROMETHEUS_AUTH_USER=prometheus
PROMETHEUS_AUTH_PASSWORD=
# Дозволені IP для /metrics endpoint (через кому), наприклад: 10.0.0.5,127.0.0.1
PROMETHEUS_ALLOWED_IPS=127.0.0.1

# ─── Моніторинг — Sentry ─────────────────────────────────────────────────────
# Отримайте DSN у своєму Sentry-проєкті (Settings → Client Keys).
# Без цього Sentry інертний; помилки в production не відстежуються.
SENTRY_DSN=
# Частка транзакцій для performance tracing (default: 0.001 = 0.1%):
SENTRY_TRACES_SAMPLE_RATE=0.001
# Кількість Sentry worker-потоків для асинхронного відправлення подій (default: 2):
SENTRY_WORKER_THREADS=2

# ─── Deploy-only (Kamal / GCP / Foundry) ─────────────────────────────────────
# Ці змінні потрібні лише для деплою — не для локальної розробки.
# Детальніше: docs/06_01_Deployment_Kamal_Terraform.md
#
# POLYGONSCAN_API_KEY=    # Верифікація контрактів через Foundry (forge --verify)
# GCP_ARTIFACT_REGISTRY_KEY=  # base64 JSON ключ GCP Service Account
# DATABASE_URL=           # Production DB (Cloud SQL)
# CANOPY_DATABASE_URL=    # Staging DB
