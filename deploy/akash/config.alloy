// =============================================================================
// Grafana Alloy Configuration — SilkenNet Observability (River format)
// =============================================================================
//
// Runs inside the Akash `alloy` sidecar. Scrapes the Rails `/metrics` endpoint
// (web service) every 15s and pushes to Grafana Cloud via Prometheus remote_write.
//
// Environment variables (injected via Akash SDL):
//   PROMETHEUS_AUTH_USER / PROMETHEUS_AUTH_PASSWORD — Basic Auth for /metrics
//   GRAFANA_REMOTE_WRITE_URL / _USERNAME / _TOKEN   — Grafana Cloud remote_write
//   RAILS_ENV (optional)        — environment label (default "production")
//   RELEASE_VERSION (optional)  — release label (regression attribution; matches Sentry)
//
// Metric registry SSOT (names, types, count) — docs/06_03 §2.8. Deliberately NOT
// restated here (avoids doc-drift); this agent scrapes whatever /metrics exposes.
//
// ⚠️ Validate after edits before deploy (no local linter in this repo):
//   docker run --rm -v "$PWD/deploy/akash:/c" grafana/alloy:latest fmt /c/config.alloy
// A River parse error makes the alloy sidecar crash-loop (see 06_02 §debug).
// =============================================================================

prometheus.scrape "silken_net_scraper" {
  targets         = [{ "__address__" = "web:80" }]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"

  basic_auth {
    username = sys.env("PROMETHEUS_AUTH_USER")
    password = sys.env("PROMETHEUS_AUTH_PASSWORD")
  }

  forward_to = [prometheus.remote_write.grafanacloud.receiver]
}

prometheus.remote_write "grafanacloud" {
  // [Industrial-grade] External labels — attribute every series to its deployment
  // so prod/canopy AND Akash multi-provider failover (06_02) stay distinguishable
  // in Grafana Cloud. Without these, series from different environments/providers
  // collide and dashboards/alerts cannot be scoped. Empty values are dropped.
  external_labels = {
    service = "silken-net",
    source  = "akash-alloy",
    env     = coalesce(sys.env("RAILS_ENV"), "production"),
    release = sys.env("RELEASE_VERSION"),
  }

  endpoint {
    url = sys.env("GRAFANA_REMOTE_WRITE_URL")

    basic_auth {
      username = sys.env("GRAFANA_REMOTE_WRITE_USERNAME")
      password = sys.env("GRAFANA_REMOTE_WRITE_TOKEN")
    }
  }

  // NB: Alloy keeps an on-disk WAL (~2h) by default, so a transient Grafana Cloud
  // outage does not lose samples. Explicit queue_config tuning (capacity / shards /
  // batch_send_deadline) is recommended once metric volume is known — see the
  // industrial-hardening roadmap in docs/06_03 (validate with `alloy fmt` first).
}
