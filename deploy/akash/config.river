// =============================================================================
// Grafana Alloy Configuration — SilkenNet Observability (River format)
// =============================================================================
//
// This configuration runs inside the Akash `alloy` sidecar service.
// It scrapes the Rails `/metrics` endpoint from the `web` service every 15s
// and pushes metrics to Grafana Cloud via Prometheus remote_write.
//
// Environment variables (injected via Akash SDL):
//   PROMETHEUS_AUTH_USER      — Basic Auth username for Rails /metrics endpoint
//   PROMETHEUS_AUTH_PASSWORD   — Basic Auth password for Rails /metrics endpoint
//   GRAFANA_REMOTE_WRITE_URL  — Grafana Cloud Prometheus endpoint
//   GRAFANA_REMOTE_WRITE_USERNAME — Grafana Cloud instance ID
//   GRAFANA_REMOTE_WRITE_TOKEN    — Grafana Cloud API token (write scope)
//
// Metrics scraped (10 custom business metrics):
//   Counters: silkennet_scc_minted_total, silkennet_scc_slashed_total,
//             silkennet_rpc_errors_total, silkennet_telemetry_processed_total,
//             silkennet_telemetry_fraud_detected_total, silkennet_slashing_events_total,
//             silkennet_ota_chunks_sent_total, silkennet_ews_alerts_total,
//             silkennet_coap_packets_received_total
//   Histogram: silkennet_oracle_dispatch_duration_seconds
//   Gauges: silkennet_sidekiq_queue_size, silkennet_sidekiq_queue_latency_seconds
// =============================================================================

prometheus.scrape "silken_net_scraper" {
  targets = [{"__address__" = "web:80"}]
  metrics_path = "/metrics"
  scrape_interval = "15s"

  basic_auth {
    username = sys.env("PROMETHEUS_AUTH_USER")
    password = sys.env("PROMETHEUS_AUTH_PASSWORD")
  }

  forward_to = [prometheus.remote_write.grafanacloud.receiver]
}

prometheus.remote_write "grafanacloud" {
  endpoint {
    url = sys.env("GRAFANA_REMOTE_WRITE_URL")

    basic_auth {
      username = sys.env("GRAFANA_REMOTE_WRITE_USERNAME")
      password = sys.env("GRAFANA_REMOTE_WRITE_TOKEN")
    }
  }
}
