// =============================================================================
// Grafana Alloy Configuration — SilkenNet Observability (River format)
// =============================================================================
//
// Runs as the Kamal `alloy` accessory (config/deploy.yml) on the app host. Scrapes
// each Rails process `/metrics` every 15s and pushes to Grafana Cloud via remote_write.
//
// Pipeline:  prometheus.scrape ─▶ prometheus.relabel (cardinality budget) ─▶
//            prometheus.remote_write (queue_config + WAL) ─▶ Grafana Cloud
//
// Environment variables (Kamal accessory env — config/deploy.yml `accessories.alloy`):
//   PROMETHEUS_AUTH_USER / PROMETHEUS_AUTH_PASSWORD — Basic Auth for /metrics
//   GRAFANA_REMOTE_WRITE_URL / _USERNAME / _TOKEN   — Grafana Cloud remote_write
//   DEPLOYMENT_SLOT             — slot label ("production" / "canopy"). The ONLY label that
//                                 separates the two slots: RAILS_ENV is "production" in both.
//   RAILS_ENV (optional)        — environment label (default "production"); CONSTANT across
//                                 slots by design, so it discriminates nothing.
//   RELEASE_VERSION (optional)  — release label. ⚠️ NOT SUPPLIED TODAY: it is absent from
//                                 `accessories.alloy.env`, so the label is empty and dropped.
//                                 The old "matches Sentry" claim had no join behind it (00_07 S2.4).
//
// Metric registry SSOT (names, types, count) — docs/06_03 §2.8. Deliberately NOT
// restated here (avoids doc-drift); this agent scrapes whatever /metrics exposes.
// Industrial-hardening rationale (external_labels / queue_config / WAL /
// cardinality budget) — docs/06_03 §2.9.
//
// ⚠️ Validate after edits before deploy (no local linter in this repo):
//   docker run --rm -v "$PWD/deploy/alloy:/c" grafana/alloy:latest fmt /c/config.alloy
// A River parse error makes the alloy accessory crash-loop.
// =============================================================================

prometheus.scrape "silken_net_scraper" {
  // The Prometheus registry is in-process: web never sees worker/daemon
  // increments, so every Ruby process is its own target (06_03 §2.9).
  // 🔴 [OPS.37] ADDRESSES ARE UNRESOLVED — the three-target CONTRACT is not.
  // The registry is in-process, so each Ruby process must be its own target; that half is
  // permanent (06_03 §2.9). HOW Alloy reaches them is an open leg: Kamal 2.12 gives no
  // stable address for a sibling container (versioned names, no network alias), and the two
  // honest mechanisms both carry a price — published host ports break the rolling deploy
  // (start_new_version precedes stop_old_version), docker-socket discovery is a root-
  // equivalent grant. The loopback form below is the SHAPE of option (a), NOT a decision:
  // this config is inert until the accessory gets a launcher. Reasoning: config/deploy.yml
  // `accessories.alloy`; decision home: 00_07 (OPS.37 leg).
  // NOTE: 9395 is the dormant Kamal `coap` FALLBACK role (idle → honest daemon-level
  // zeros); the PRIMARY daemon lives on the Ingress Anchor, outside this host's scrape
  // reach — ceiling documented in 06_03 §2.9(б), unchanged by the platform move.
  // The `process` label makes sum/max by (process) queries readable;
  // `instance` (auto-set from __address__) already disambiguates.
  targets = [
    { "__address__" = "127.0.0.1:9393", "process" = "web" },
    { "__address__" = "127.0.0.1:9394", "process" = "job" },
    { "__address__" = "127.0.0.1:9395", "process" = "coap" },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"

  basic_auth {
    username = sys.env("PROMETHEUS_AUTH_USER")
    password = sys.env("PROMETHEUS_AUTH_PASSWORD")
  }

  // Route through the cardinality budget before remote_write (06_03 §2.9 #4).
  forward_to = [prometheus.relabel.cardinality_budget.receiver]
}

prometheus.relabel "cardinality_budget" {
  // [Industrial-grade, 06_03 §2.9 #4] Cardinality budget — enforce the
  // "no per-identity labels" design at the write boundary. The registry
  // (06_03 §2.8) is intentionally bounded: every label is low-cardinality
  // (network / queue / reason / status / database …) except `cluster_id`
  // (per-forest entropy) — the single legitimate growth axis, kept as-is.
  //
  // Grafana Cloud bills by active series / DPM, so a per-device or per-tx
  // label would explode cost the moment it shipped. `labeldrop` strips any
  // such label BEFORE remote_write, so an accidental future `labels: [:did]`
  // can never silently blow the budget — the metric still flows, minus the
  // offending label. No such label exists today (zero current effect); this
  // is a standing guardrail, not a migration.
  rule {
    action = "labeldrop"
    regex  = "did|tree_id|peaq_did|wallet_address|tx_hash"
  }

  forward_to = [prometheus.remote_write.grafanacloud.receiver]
}

prometheus.remote_write "grafanacloud" {
  // [Industrial-grade] External labels — attribute every series to its deployment
  // so the prod and canopy slots stay distinguishable in Grafana Cloud. Without these,
  // series from different environments collide and dashboards/alerts cannot be scoped.
  // Empty values are dropped.
  external_labels = {
    service = "silken-net",
    source  = "kamal-alloy",
    env     = coalesce(sys.env("RAILS_ENV"), "production"),
    // RAILS_ENV is "production" for BOTH slots (canopy differs only by
    // POSTGRES_DATABASE), so a canopy deploy would otherwise merge its series
    // with production's. DEPLOYMENT_SLOT is set in the accessory env:
    // "production" default, "canopy" for a canopy deploy.
    slot    = coalesce(sys.env("DEPLOYMENT_SLOT"), "production"),
    release = sys.env("RELEASE_VERSION"),
  }

  endpoint {
    url = sys.env("GRAFANA_REMOTE_WRITE_URL")

    basic_auth {
      username = sys.env("GRAFANA_REMOTE_WRITE_USERNAME")
      password = sys.env("GRAFANA_REMOTE_WRITE_TOKEN")
    }

    // [Industrial-grade, 06_03 §2.9 #2] queue_config — bound the remote_write
    // shard fan-out and batch sizing. Under a Grafana Cloud slowdown the queue
    // scales shards (1→50) and applies backpressure instead of growing memory
    // unbounded; capacity caps in-flight samples per shard. Tuned for the
    // current low metric volume — revisit once fleet scale is known.
    queue_config {
      capacity             = 10000
      max_samples_per_send = 2000
      min_shards           = 1
      max_shards           = 50
      batch_send_deadline  = "5s"
    }
  }

  // [Industrial-grade, 06_03 §2.9 #2] Explicit WAL — make the on-disk buffer
  // window explicit (was relying on the ~2h default). A transient Grafana Cloud
  // outage is replayed from the WAL with no sample loss; truncated every 2h to
  // bound disk. Values mirror Alloy defaults — explicit so they are tunable and
  // self-documenting, not behaviour changes.
  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}
