# Нагадування про re-squash у МОМЕНТ, коли борг зростає [OPS.24].
#
# 🔑 Чому саме тут, а не хук і не CI-гейт:
#   · **не хук** — той спрацював би лише в коді-агента, а міграцію може додати будь-хто;
#     носій мусить стояти там, де стоїть ДІЯ, а дія тут — `db:migrate`;
#   · **не CI-гейт** — він червонів би постійно від пʼятої міграції до сквошу, а постійний
#     червоний перестають читати рівно так само, як тиху пораду; до того ж уся ця політика
#     має названий ЗАХІД СОНЦЯ (нижче), і гейт довелося б комусь памʼятати зняти.
#
# ⚖️ ЗАХІД СОНЦЯ, названий явно: re-squash має сенс ЛИШЕ доти, доки немає прод-БД.
# Після першого живого деплою переписувати анкер стане неможливо (прод уже проставив
# рядки в `schema_migrations`), і сквошити ніхто не буде — тож у той день цей файл
# ВИДАЛЯЄТЬСЯ разом із процедурою в шапці анкера. Це записано тут, а не в трекері,
# бо читає його той, хто робитиме деплой, а не той, хто веде трекер.
#
# Поріг — присуд founder-а 2026-08-23 («як пʼять міграцій, то сквошимо»). Виміряний темп
# ~1 міграція/добу, тож нагадування спрацьовує приблизно раз на 4–5 днів, а не щоразу.
namespace :db do
  SQUASH_REMINDER_THRESHOLD = 5

  task migrate: :environment do
    anchor = Dir[Rails.root.join("db/migrate/*_init_consolidated.rb")].max
    # Анкера немає → або checkout неповний (це вже голосно ловить ініціалізатор
    # StrongMigrations), або сквош-епоха скінчилась. Мовчимо: нагадувати нема про що.
    next if anchor.nil?

    incrementals = Dir[Rails.root.join("db/migrate/*.rb")].size - 1
    next if incrementals < SQUASH_REMINDER_THRESHOLD

    warn <<~MSG

      ⚠️  [OPS.24] Інкрементальних міграцій поверх анкера: #{incrementals} (поріг #{SQUASH_REMINDER_THRESHOLD}).
          Проєкт pre-launch: `db/structure.sql` самодостатній, тож інкрементальні —
          це борг, а не історія. Процедура re-squash — у шапці #{anchor.sub("#{Rails.root}/", '')}.
          ⊕ Крок «bump StrongMigrations.start_after» більше НЕ ручний: значення
            виводиться з імені файлу анкера, тож перенести його неправильно вже не можна.

    MSG
  end
end
