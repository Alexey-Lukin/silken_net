# frozen_string_literal: true

require_relative "../../config/environment"
require "socket"
require "base64"

# Налаштування для Kamal/Docker логів
$stdout.sync = true

# Порт за замовчуванням для CoAP (один дім — CoapSmoke::DEFAULT_PORT)
PORT = ENV.fetch("COAP_PORT", CoapSmoke::DEFAULT_PORT).to_i

socket = UDPSocket.new
socket.bind("0.0.0.0", PORT)

# [INF.17 / 06_03 §2.9] Демон віддає власний зріз Prometheus-реєстру — web:80
# його не бачить (реєстр in-process). ⚠️ Але «третій scrape-таргет», як тут стояло
# до 2026-09-01, правда лише про ДОРМАНТНУ Kamal `coap`-роль: Alloy живе на
# app-хості й Ingress Anchor не дістає, тож коли ЦЕЙ файл біжить як PRIMARY на
# анкері, його :9395 не скрейпить НІХТО. Видимість анкер-демона йде іншими
# каналами (worker-half `coap_packets`, INF.6 smoke, Sentry, ARCH.81 UDP-проба) —
# стеля §2.9(б). Тобто рядок нижче піднімає експортер, який на PRIMARY-шляху
# сьогодні є мертвим портом за призначенням, а не за помилкою.
SilkenNet::MetricsExporter.start(port: ENV.fetch("METRICS_PORT", 9395).to_i)

Rails.logger.info "🌳 [Sanctum] UDP/CoAP Брама відкрита на порту #{PORT}. Слухаємо дихання лісу..."
# The ASCII half of this line is the runbook's ACCEPTANCE line (06_01 Фаза 4): grep-stable in
# `docker logs silkennet-coap` whatever the locale. Until 2026-09-02 the runbook cited
# «Listening on coap://…» while the daemon printed only the Ukrainian line — the operator's
# first grep on deploy day would have found nothing. `slot=` names which deploy the intake
# feeds (OPS.37: one anchor daemon, switched by three coap.env lines); the row in that
# slot's DB is the proof, this line only says what the daemon BELIEVES.
puts "🛰️  Listening on coap://0.0.0.0:#{PORT} slot=#{SilkenNet::DeploymentSlot.current} — " \
     "система моніторингу ефіру активована. Очікування пакетів..."

# Граматика RFC 7252 живе у pure CoapServerPdu (дзеркало firmware
# coap_pdu.h, e2e golden-parity у spec/lib/coap_server_pdu_spec.rb).
# Демон — лише UDP-клей: recvfrom → вердикт → відповідь → perform_async.
# ACK 2.04 летить ПІСЛЯ маршрутизації: Королева чистить CIFO [FW.51]
# тільки тоді, коли батч справді поставлено у чергу.

# ПРОТОКОЛ ПРАВИЛЬНОГО ЗАВЕРШЕННЯ
running = true
%w[INT TERM].each do |signal|
  trap(signal) do
    puts "\n🛑 [Sanctum] Отримано сигнал #{signal}. Ефір закривається..."
    running = false
  end
end

while running
  begin
    if IO.select([ socket ], nil, nil, 1)
      data, sender = socket.recvfrom_nonblock(CoapGate::MAX_PACKET_SIZE)
      gateway_ip = sender[3]
      # [FW.56] Тіло обробки — у тестованому CoapGate.handle_datagram: enqueue
      # живе ТАМ, перед поверненням reply, тож ACK 2.04 структурно не випередить
      # черги (FW.51). Демон лишається select-лупом + trap + metrics-boot.
      reply = CoapGate.handle_datagram(data: data, gateway_ip: gateway_ip)
      socket.send(reply, 0, gateway_ip, sender[1]) if reply
    end
  rescue Errno::EAGAIN, Errno::EWOULDBLOCK
    retry
  rescue StandardError => e
    puts "🛑 [Sanctum Error] #{e.message}"
    Rails.logger.error "🛑 [Sanctum] Збій у матриці: #{e.message}\n#{e.backtrace.first(3).join("\n")}"
  end
end

socket.close
puts "🔒 [Sanctum] Брама закрита. Ефір мовчить."
