#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../../config/environment"
require "socket"
require "base64"

# Налаштування для Kamal/Docker логів
$stdout.sync = true

# Порт за замовчуванням для CoAP
PORT = ENV.fetch("COAP_PORT", 5683).to_i
MAX_PACKET_SIZE = 2048

socket = UDPSocket.new
socket.bind("0.0.0.0", PORT)

Rails.logger.info "🌳 [Sanctum] UDP/CoAP Брама відкрита на порту #{PORT}. Слухаємо дихання лісу..."
puts "🛰️  Система моніторингу ефіру активована. Очікування пакетів..."

# Граматика RFC 7252 живе у pure CoapServerPdu (дзеркало firmware
# coap_pdu.h, e2e golden-parity у spec/lib/coap_server_pdu_spec.rb).
# Демон — лише UDP-клей: recvfrom → вердикт → відповідь → perform_async.
# ACK 2.04 летить ПІСЛЯ маршрутизації: Королева чистить CIFO [FW.51]
# тільки тоді, коли батч справді поставлено у чергу.

# ПРОТОКОЛ ПРАВИЛЬНОГО ЗАВЕРШЕННЯ
running = true
%w[INT TERM].each do |signal|
  trap(signal) do
    puts "\n🛑 [Sanctum] Отримано сигнал #{signal}. Ефір закривається..."
    running = false
  end
end

while running
  begin
    if IO.select([ socket ], nil, nil, 1)
      data, sender = socket.recvfrom_nonblock(MAX_PACKET_SIZE)
      gateway_ip = sender[3]
      timestamp = Time.current

      result = CoapServerPdu.handle_telemetry_datagram(data)

      case result.status
      when :telemetry_batch
        encoded_payload = Base64.strict_encode64(result.payload)
        UnpackTelemetryWorker.perform_async(encoded_payload, gateway_ip, result.gateway_uid)
        puts "📥 [#{timestamp.strftime('%T')}] Пакет від #{result.gateway_uid || gateway_ip} прийнято (#{result.payload.bytesize}б)"
      when :unknown_route
        puts "⚠️  [#{timestamp.strftime('%T')}] Відхилено (4.04): невідомий маршрут від #{gateway_ip}"
      when :malformed
        puts "⚠️  [#{timestamp.strftime('%T')}] Нечитабельний датаграм від #{gateway_ip} (#{data.bytesize}б) — RST"
      end

      socket.send(result.reply, 0, gateway_ip, sender[1]) if result.reply
    end
  rescue Errno::EAGAIN, Errno::EWOULDBLOCK
    retry
  rescue StandardError => e
    puts "🛑 [Sanctum Error] #{e.message}"
    Rails.logger.error "🛑 [Sanctum] Збій у матриці: #{e.message}\n#{e.backtrace.first(3).join("\n")}"
  end
end

socket.close
puts "🔒 [Sanctum] Брама закрита. Ефір мовчить."
