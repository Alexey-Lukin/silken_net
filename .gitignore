# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, but keep the example template.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

.DS_Store
vendor/bundle

# RSpec example status persistence
/spec/examples.txt

# SimpleCov coverage reports
/coverage/

# Terraform (GCP)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
# ЕФЕКТИВНА постава комічена навмисно — інакше CI-план не бачить оверрайдів і weekly
# drift стає вічно червоним (підстава — шапка самого файлу). Секретів у ньому немає.
!terraform/*.auto.tfvars
# 🔒 `.terraform.lock.hcl` КОМІТИТЬСЯ з 2026-09-06 — рядок його ігнорування знято.
# Підстава: без нього єдиним піном провайдера лишалась константа `~> 8.0` у main.tf,
# тобто свіжий `init` брав будь-який 8.x і БЕЗ звірки хешів — вужче, ніж наша постава
# деінде (`pip --require-hashes`, sha256 бінарів, SHA-піни екшенів). Лок дає і точну
# версію, і checksum-верифікацію при кожному `init`. Дім обґрунтування — 06_07 §1a.
# ⛔ Оновлюючи його, ЗАВЖДИ через `terraform providers lock -platform=linux_amd64
# -platform=darwin_arm64`: простий `init -upgrade` запише хеші ЛИШЕ для платформи,
# на якій біг, і `terraform init` у CI (ubuntu = linux_amd64 — `ci.yml` і
# `terraform_drift.yml`, обидва) впаде на відсутньому пакеті. Перелік платформ = ті,
# що реально роблять `init`, не «про запас».
terraform/tfplan

# ML model artifacts (trained binary, not committed)
lib/assets/silken_forest.marshal
lib/assets/silken_forest.marshal.sha256

# Firmware test binaries (host-based, compiled with gcc)
# Firmware host-test binaries — single canonical list lives below (the
# "/firmware/test/*" block); this duplicate stripped 2026-06-06 to kill the
# two-places-to-edit drift (it was already missing seed/ccm/sym binaries).

# Subgraph build artifacts (The Graph)
subgraph/build/
subgraph/generated/
subgraph/node_modules/
# [OPS.36] `graph test` кладе СВОЇ артефакти у `tests/` — поруч із самими тестами, а не
# в `build/`: прибудований бінар matchstick (`.bin/`) і кеш перевірки версії
# (`.latest.json`, TTL доба). Обидва підтягуються самим CLI, тож у репо їм місця немає.
# ⚠️ Правило вузьке НАВМИСНО — сама тека `tests/` версіонується, інакше тест-шар зник би
# разом із артефактами, які він приніс.
subgraph/tests/.bin/
subgraph/tests/.latest.json

# Smart contracts dependencies (Solidity)
contracts/node_modules/

# Foundry build artifacts
contracts/out/
contracts/cache/
contracts/broadcast/

coverage/

