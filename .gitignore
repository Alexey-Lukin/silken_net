# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, but keep the example template.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

.DS_Store
vendor/bundle

# RSpec example status persistence
/spec/examples.txt

# SimpleCov coverage reports
/coverage/

# Terraform (GCP)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform.lock.hcl
terraform/tfplan

# Terraform (Akash)
terraform/akash/.terraform/
terraform/akash/*.tfstate
terraform/akash/*.tfstate.*
terraform/akash/*.tfvars
!terraform/akash/*.tfvars.example
terraform/akash/.terraform.lock.hcl
terraform/akash/tfplan
terraform/akash/generated-deploy.yaml
terraform/akash/akash-dseq.txt

# ML model artifacts (trained binary, not committed)
lib/assets/silken_forest.marshal
lib/assets/silken_forest.marshal.sha256

# Firmware test binaries (host-based, compiled with gcc)
# Firmware host-test binaries — single canonical list lives below (the
# "/firmware/test/*" block); this duplicate stripped 2026-06-06 to kill the
# two-places-to-edit drift (it was already missing seed/ccm/sym binaries).

# Subgraph build artifacts (The Graph)
subgraph/build/
subgraph/generated/
subgraph/node_modules/

# Smart contracts dependencies (Solidity)
contracts/node_modules/

# Foundry build artifacts
contracts/out/
contracts/cache/
contracts/broadcast/

coverage/

# Firmware host-test binaries — build artifacts produced by `make -C firmware/test`.
# Platform-specific (macOS Mach-O vs Linux ELF) — CI rebuilds them per run.
# The .c source files are tracked; the compiled outputs are not.
/firmware/test/test_queen
/firmware/test/test_queen_rx_route
/firmware/test/test_soldier
/firmware/test/test_bio_contract
/firmware/test/test_tinyml
/firmware/test/test_logmel
/firmware/test/test_audio_model
/firmware/test/test_encryption
/firmware/test/test_seed_derivation
/firmware/test/test_ccm
/firmware/test/test_ccm_selftest
/firmware/test/test_sym_selftest
/firmware/test/test_at_engine
/firmware/test/test_uart_rx_ring
/firmware/test/test_flash_kv
/firmware/test/test_flash_ring
/firmware/test/test_queen_attest
/firmware/test/test_flash_ota
/firmware/test/test_key_ratchet
/firmware/test/test_soldier_cmd_queue
/firmware/test/test_fauna_session
/firmware/test/test_bme280
/firmware/test/test_tdma_schedule
/firmware/test/test_cad_sniff
/firmware/test/test_helium_sos
/firmware/test/test_soft_timer
/firmware/test/test_helium_mac_smoke
# macOS clang debug-symbol bundles (the -g ASan/coverage lanes emit these)
/firmware/test/*.dSYM/
# [TEST.1] coverage-lane artifacts (make -C firmware/test coverage)
/firmware/test/*.gcno
/firmware/test/*.gcda
/firmware/test/*.gcov
/firmware/test/coverage_raw.txt
.claude/scheduled_tasks.lock

# Python tooling artifacts (tools/** — pytest, compileall, ruff)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# особисті вкладення, що потрапляють у корінь із чату — НЕ версіонуються
image-*.jpg
image-*.png
