{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/oleksiilukin/silken_net/.claude/hooks/ssot_guard_hint.sh",
            "timeout": 5,
            "statusMessage": "SSOT discipline check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/oleksiilukin/silken_net/.claude/hooks/doc_drift_check.sh",
            "timeout": 10,
            "statusMessage": "Checking doc drift..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/oleksiilukin/silken_net/.claude/hooks/memory_gate.sh",
            "timeout": 10,
            "statusMessage": "Checking memory growth..."
          }
        ]
      }
    ]
  }
}
